# ==============================================================================
# Biến môi trường mẫu cho Docker Development Container (BE + FE)
# ==============================================================================

# Project Identifier
COMPOSE_PROJECT_NAME=core-framework

# Application
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Node.js Runtime Memory Optimization (Kích hoạt GC chủ động khi chạm ngưỡng)
NODE_OPTIONS=--max-old-space-size=384

# Database (Kết nối tới MySQL trên WSL2/Host qua host.docker.internal)
# Hỗ trợ đổi linh hoạt: mysql | pgsql | mssql | sqlite
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=core_db
DB_USERNAME=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=5
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (Kết nối tới Redis trên WSL2/Host qua host.docker.internal)
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PREFIX=core_framework:

# Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=development_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Frontend API URL
VITE_API_BASE_URL=http://localhost:3005/api/v1

# ---------------------------------------------------------------------------
# Runtime Operations (System Console → Runtimes)
# ---------------------------------------------------------------------------
# Redis dùng chung? Mọi key đều nằm dưới REDIS_PREFIX, không bao giờ FLUSHDB.
REDIS_PASSWORD=
REDIS_DB=0
# Tiến trình dựng lại runtime khi nó tự thoát (restart): docker | pm2 | systemd | none
# (docker-compose đã tự đặt =docker cho từng service)
RUNTIME_SUPERVISOR=none
RUNTIME_HEARTBEAT_MS=5000
RUNTIME_SAMPLE_INTERVAL_MS=15000
RUNTIME_MEMORY_WARN_PERCENT=85
RUNTIME_CPU_WARN_PERCENT=85
RUNTIME_EVENT_LOOP_WARN_MS=100
RUNTIME_RESTART_STORM_COUNT=3
RUNTIME_RESTART_STORM_WINDOW_MIN=10
RUNTIME_GRACEFUL_TIMEOUT_MS=30000
# Cho phép Restart/Stop/Start từ Console. /ops/* chưa có RBAC → nên đặt false ở production.
OPS_RUNTIME_ACTIONS_ENABLED=true
WORKER_CONCURRENCY=5
SCHEDULER_MAINTENANCE_CRON=*/5 * * * *

# ------------------------------------------------------------------------------
# HTTP Traffic (System Console → HTTP Traffic) — aggregate trong Redis, không lưu mọi body
# ------------------------------------------------------------------------------
TRAFFIC_ENABLED=true
# TRAFFIC_INSTANCE_ID=            # mặc định: hostname (trong Docker là container id)
TRAFFIC_FLUSH_MS=5000
TRAFFIC_SLOW_MS=500
TRAFFIC_LONG_RUNNING_MS=3000
# Tỷ lệ request bình thường được lưu chi tiết (request chậm/lỗi luôn được lưu)
TRAFFIC_SAMPLE_RATE=0.01
TRAFFIC_CAPTURE_BODIES=true
TRAFFIC_MAX_BODY_BYTES=8192
TRAFFIC_REQUEST_LOG_SIZE=5000
# Glob phân tách bằng dấu phẩy, vd /api/v1/health*
TRAFFIC_EXCLUDE_ROUTES=
TRAFFIC_EXCLUDE_METHODS=OPTIONS
TRAFFIC_INTERNAL_MODULES=ops,health
TRAFFIC_ENDPOINT_P95_WARN_MS=500
TRAFFIC_ERROR_RATE_WARN_PERCENT=2
TRAFFIC_ERROR_RATE_CRIT_PERCENT=10
TRAFFIC_SPIKE_INCREASE_PERCENT=100
TRAFFIC_MIN_RPS_FOR_ALERT=1
TRAFFIC_MIN_REQUESTS_FOR_STATUS=20

# ------------------------------------------------------------------------------
# Performance (System Console → Performance) — số đo runtime/DB/cache/worker trong Redis
# (bucket 10s/1m/1h, giữ 2h/25h/8 ngày)
# ------------------------------------------------------------------------------
PERF_ENABLED=true
PERF_FLUSH_MS=5000
# Chu kỳ đánh giá rule để ghi sự kiện bắt đầu/hồi phục điểm nghẽn.
PERF_EVALUATE_MS=30000
# Query chậm hơn ngưỡng này được lưu (SQL đã bỏ giá trị literal, không lưu params).
PERF_DB_SLOW_MS=200
# Ngưỡng phát hiện điểm nghẽn (WARN = cảnh báo, CRIT = nghiêm trọng).
PERF_API_P95_MS_WARN=500
PERF_API_P95_MS_CRIT=1000
PERF_API_P99_MS_WARN=1000
PERF_API_P99_MS_CRIT=2000
PERF_ERROR_RATE_PERCENT_WARN=2
PERF_ERROR_RATE_PERCENT_CRIT=10
PERF_CPU_PERCENT_WARN=75
PERF_CPU_PERCENT_CRIT=90
PERF_CPU_SUSTAIN_MIN=2
PERF_MEMORY_PERCENT_WARN=80
PERF_MEMORY_PERCENT_CRIT=90
PERF_MEMORY_GROWTH_WINDOW_MIN=30
PERF_MEMORY_GROWTH_MB=100
PERF_EVENT_LOOP_MS_WARN=100
PERF_EVENT_LOOP_MS_CRIT=250
PERF_GC_PAUSE_MS_PER_MIN_WARN=1000
PERF_GC_PAUSE_MS_PER_MIN_CRIT=3000
PERF_DB_P95_MS_WARN=300
PERF_DB_P95_MS_CRIT=1000
PERF_DB_POOL_PERCENT_WARN=85
PERF_DB_POOL_PERCENT_CRIT=95
PERF_QUEUE_WAITING_WARN=500
PERF_QUEUE_WAITING_CRIT=2000
PERF_WORKER_FAILED_PERCENT_WARN=5
PERF_WORKER_FAILED_PERCENT_CRIT=20
# Mục tiêu hiệu năng (performance budget) hiển thị ✓/✕.
PERF_BUDGET_API_P95_MS=200
PERF_BUDGET_API_P99_MS=500
PERF_BUDGET_ERROR_RATE_PERCENT=1
PERF_BUDGET_CPU_PERCENT=75
PERF_BUDGET_MEMORY_PERCENT=80
