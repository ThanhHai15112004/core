# ==============================================================================
# Biến môi trường mẫu cho Docker Development Container (BE + FE)
# ==============================================================================

# Project Identifier
COMPOSE_PROJECT_NAME=core-framework

# Application
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Node.js Runtime Memory Optimization (Kích hoạt GC chủ động khi chạm ngưỡng)
NODE_OPTIONS=--max-old-space-size=384

# Database (Kết nối tới MySQL trên WSL2/Host qua host.docker.internal)
# Hỗ trợ đổi linh hoạt: mysql | pgsql | mssql | sqlite
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=core_db
DB_USERNAME=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=5
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (Kết nối tới Redis trên WSL2/Host qua host.docker.internal)
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PREFIX=core_framework:

# Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=development_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Frontend API URL
VITE_API_BASE_URL=http://localhost:3005/api/v1
