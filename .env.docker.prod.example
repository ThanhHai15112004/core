# ==============================================================================
# Biến môi trường mẫu cho Production trên VPS / Server (Core Framework)
# Sao chép file này thành .env.docker.prod trên server trước khi chạy docker-prod.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Thông tin Domain & SSL Let's Encrypt
# ------------------------------------------------------------------------------
DOMAIN_NAME=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 2. Cấu hình Ứng dụng
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=core-framework-prod
NODE_ENV=production
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Node.js V8 Memory Optimization (Giới hạn Heap kích hoạt GC chủ động)
NODE_OPTIONS=--max-old-space-size=400

# ------------------------------------------------------------------------------
# 3. Cơ sở dữ liệu (Hỗ trợ: pgsql | mysql | mssql | sqlite)
# Nếu dùng Managed DB từ xa (AWS RDS, DigitalOcean Managed DB) hoặc DB local
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=core_prod_db
DB_USERNAME=core_prod_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DB_MAX_CONNECTIONS=20
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ------------------------------------------------------------------------------
# 4. Redis Cache & Session
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=core_prod:

# ------------------------------------------------------------------------------
# 5. Xác thực & Bảo mật (JWT Secrets - Hãy tạo bằng: openssl rand -base64 32)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_VERY_LONG_SECRET_KEY_MIN_32_CHARS_ACCESS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_VERY_LONG_SECRET_KEY_MIN_32_CHARS_REFRESH
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 6. Lưu trữ tệp tin (local | s3)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads

# ------------------------------------------------------------------------------
# 7. Frontend API URL
# Để rỗng hoặc /api/v1 để request đi qua Nginx Reverse Proxy trên cùng domain
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
