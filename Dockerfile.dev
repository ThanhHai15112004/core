FROM node:22-alpine

# Cài đặt bash và curl phục vụ kiểm tra kết nối & quản trị
RUN apk add --no-cache bash curl

WORKDIR /app

# Copy các file cấu hình package
COPY package.json pnpm-workspace.yaml* ./
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/

# Cài đặt dependencies
RUN npm --prefix backend install
RUN npm --prefix frontend install

# Copy mã nguồn ban đầu
COPY backend ./backend
COPY frontend ./frontend
COPY docker/entrypoint.dev.sh /app/docker/entrypoint.dev.sh

RUN chmod +x /app/docker/entrypoint.dev.sh

EXPOSE 3005 5175

ENTRYPOINT ["/app/docker/entrypoint.dev.sh"]
