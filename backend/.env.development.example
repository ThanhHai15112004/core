# Application
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Database (Hỗ trợ: mysql | pgsql | mssql | sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=core_db
DB_USERNAME=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=10
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=core:

# Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=development_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ---------------------------------------------------------------------------
# Runtime Operations (System Console → Runtimes)
# ---------------------------------------------------------------------------
# Redis dùng chung? Mọi key đều nằm dưới REDIS_PREFIX, không bao giờ FLUSHDB.
REDIS_PASSWORD=
REDIS_DB=0
# Tiến trình dựng lại runtime khi nó tự thoát (restart): docker | pm2 | systemd | none
# (docker-compose đã tự đặt =docker cho từng service)
RUNTIME_SUPERVISOR=none
RUNTIME_HEARTBEAT_MS=5000
RUNTIME_SAMPLE_INTERVAL_MS=15000
RUNTIME_MEMORY_WARN_PERCENT=85
RUNTIME_CPU_WARN_PERCENT=85
RUNTIME_EVENT_LOOP_WARN_MS=100
RUNTIME_RESTART_STORM_COUNT=3
RUNTIME_RESTART_STORM_WINDOW_MIN=10
RUNTIME_GRACEFUL_TIMEOUT_MS=30000
# Cho phép Restart/Stop/Start từ Console. /ops/* chưa có RBAC → nên đặt false ở production.
OPS_RUNTIME_ACTIONS_ENABLED=true
WORKER_CONCURRENCY=5
SCHEDULER_MAINTENANCE_CRON=*/5 * * * *

# ------------------------------------------------------------------------------
# HTTP Traffic (System Console → HTTP Traffic) — aggregate trong Redis, không lưu mọi body
# ------------------------------------------------------------------------------
TRAFFIC_ENABLED=true
# TRAFFIC_INSTANCE_ID=            # mặc định: hostname (trong Docker là container id)
TRAFFIC_FLUSH_MS=5000
TRAFFIC_SLOW_MS=500
TRAFFIC_LONG_RUNNING_MS=3000
# Tỷ lệ request bình thường được lưu chi tiết (request chậm/lỗi luôn được lưu)
TRAFFIC_SAMPLE_RATE=0.01
TRAFFIC_CAPTURE_BODIES=true
TRAFFIC_MAX_BODY_BYTES=8192
TRAFFIC_REQUEST_LOG_SIZE=5000
# Glob phân tách bằng dấu phẩy, vd /api/v1/health*
TRAFFIC_EXCLUDE_ROUTES=
TRAFFIC_EXCLUDE_METHODS=OPTIONS
TRAFFIC_INTERNAL_MODULES=ops,health
TRAFFIC_ENDPOINT_P95_WARN_MS=500
TRAFFIC_ERROR_RATE_WARN_PERCENT=2
TRAFFIC_ERROR_RATE_CRIT_PERCENT=10
TRAFFIC_SPIKE_INCREASE_PERCENT=100
TRAFFIC_MIN_RPS_FOR_ALERT=1
TRAFFIC_MIN_REQUESTS_FOR_STATUS=20
