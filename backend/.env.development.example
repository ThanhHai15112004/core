# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=core_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=10

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=core:

# Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=development_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
