# Application
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1

# Database (Hỗ trợ: mysql | pgsql | mssql | sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=core_db
DB_USERNAME=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=10
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=core:

# Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=development_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
