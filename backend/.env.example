# ==============================================================================
# 1. Application
# ==============================================================================
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
APP_NAME=core-service
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

# ==============================================================================
# 2. Database (Hỗ trợ: mysql | pgsql | mssql | sqlite)
# ==============================================================================
DB_ENABLED=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Tách đọc/ghi khi thật sự cần (để trống = đọc/ghi chung trên DB_HOST mặc định)
DB_READ_HOST=
DB_READ_PORT=3306
DB_DATABASE=core_db
DB_USERNAME=root
DB_PASSWORD=root
DB_MAX_CONNECTIONS=10
# Số kết nối nhàn rỗi tối đa giữ lại trong pool (0 = bằng DB_MAX_CONNECTIONS)
DB_POOL_MAX_IDLE=0
# Thời gian tối đa (ms) giữ kết nối nhàn rỗi trong pool trước khi đóng
DB_POOL_IDLE_TIMEOUT_MS=60000
# Giới hạn hàng đợi chờ kết nối khi pool đầy (0 = không giới hạn)
DB_POOL_QUEUE_LIMIT=0
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=10000
# Thời gian tối đa (ms) cho phép một query thực thi trước khi bị ngắt (0 = không giới hạn)
DB_QUERY_TIMEOUT_MS=30000
DB_HEALTH_INTERVAL_MS=5000
DB_MIGRATIONS_TABLE=core_migrations
# Database Monitor (System Console → Database). User DB chỉ cần quyền trên database của app
# + SELECT performance_schema (MySQL) — không cần PROCESS; Console chỉ thấy/tác động session của chính user này.
DB_SLOW_QUERY_MS=500
DB_LONG_TX_SEC=10
# Thời gian tối đa (ms) cho phép một transaction chạy qua TransactionManager trước khi tự động rollback (0 = không giới hạn)
DB_TRANSACTION_TIMEOUT_MS=30000
# Bảo vệ không cho phép chạy migration nếu phát hiện bản di trú đã áp dụng bị sửa đổi hoặc xóa file
DB_MIGRATION_STRICT=true
# Dung lượng cấp cho database (GB) để tính % sử dụng; 0 = không biết.
DB_STORAGE_LIMIT_GB=0
DB_STORAGE_WARN_PERCENT=80
# Cancel query / terminate session từ Console (gõ xác nhận). Chưa có RBAC → cân nhắc tắt ở production.
OPS_DATABASE_ACTIONS_ENABLED=true
# Chạy migration từ Console (gõ MIGRATE).
OPS_DATABASE_MIGRATIONS_ENABLED=true

# ==============================================================================
# 3. Redis & Cache (System Console → Infrastructure → Cache)
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=core:
REDIS_PASSWORD=
REDIS_DB=0

# redis: dùng chung giữa API/Worker/Scheduler, key `<REDIS_PREFIX>cache:*`; memory: Map riêng từng process
CACHE_DRIVER=redis
# TTL mặc định (giây) khi set() không truyền TTL; 0 = không hết hạn
CACHE_DEFAULT_TTL_SEC=0
# Namespace = tối đa N segment đầu của key (`data:users:12` → `data:users`)
CACHE_NAMESPACE_DEPTH=2
# Giới hạn số key quét (SCAN) mỗi lần chụp keyspace
CACHE_SCAN_MAX_KEYS=100000
# Hạn mức bộ nhớ cho cache (MB) khi Redis không đặt maxmemory; 0 = không biết
CACHE_MEMORY_LIMIT_MB=0
# Namespace chứa session (cảnh báo khi flush) / nhạy cảm (không bao giờ xem value)
CACHE_SESSION_NAMESPACES=auth:session,session
CACHE_SENSITIVE_NAMESPACES=token,otp,password,auth
# Ngưỡng cảnh báo Cache
CACHE_HIT_RATE_WARN_PERCENT=80
CACHE_HIT_RATE_DROP_POINTS=15
CACHE_HIT_RATE_MIN_READS=50
CACHE_MEMORY_WARN_PERCENT=80
CACHE_MEMORY_CRIT_PERCENT=90
CACHE_EXPIRY_SPIKE_KEYS=1000
CACHE_LARGE_KEY_BYTES=1048576
CACHE_CONNECTION_WARN_PERCENT=80
# Thao tác từ System Console (chưa có RBAC cho /ops — nên tắt ở production)
OPS_CACHE_ACTIONS_ENABLED=true
OPS_CACHE_FLUSH_ENABLED=true
# Xem trước value (đã che field nhạy cảm, tối đa 2 KB)
OPS_CACHE_VALUE_PREVIEW=true

# ==============================================================================
# 4. Authentication & Secrets
# ==============================================================================
# Nguồn đọc secret: env (mặc định) hoặc file (Docker secrets / mount)
SECRET_DRIVER=env
SECRET_DIR=
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==============================================================================
# 5. Storage (System Console → Storage)
# ==============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Domain CDN hoặc URL công khai gốc (ví dụ: https://cdn.example.com) — chỉ áp dụng cho file PUBLIC
STORAGE_CDN_URL=
# local: file thật dưới STORAGE_LOCAL_PATH; s3: S3-compatible (AWS S3, MinIO…)
# S3/MinIO (khi STORAGE_DRIVER=s3). Credentials đọc qua SecretService (SECRET_DRIVER), fallback env.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_ACCESS_KEY_SECRET=STORAGE_S3_ACCESS_KEY
STORAGE_S3_SECRET_KEY_SECRET=STORAGE_S3_SECRET_KEY
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_TIMEOUT_MS=30000
# Storage Monitor (System Console → Storage)
# Dung lượng cấp cho storage (GB) khi provider không tự báo (S3/MinIO); 0 = không biết
STORAGE_CAPACITY_GB=0
STORAGE_SCAN_MAX_OBJECTS=200000
STORAGE_STALE_UPLOAD_MIN=60
STORAGE_LARGE_OBJECT_MB=500
# Prefix chứa dữ liệu nhạy cảm — không bao giờ preview nội dung
STORAGE_SENSITIVE_PREFIXES=private/,contracts/,secrets/
STORAGE_SIGNED_URL_MAX_SEC=86400
STORAGE_CAPACITY_WARN_PERCENT=80
STORAGE_CAPACITY_CRIT_PERCENT=90
STORAGE_GROWTH_FACTOR=3
STORAGE_GROWTH_MIN_MB=100
STORAGE_STALE_UPLOADS=1
# Thao tác từ System Console (chưa có RBAC cho /ops — nên tắt ở production)
OPS_STORAGE_DELETE_ENABLED=true
OPS_STORAGE_DOWNLOAD_ENABLED=true
OPS_STORAGE_SIGNED_URL_ENABLED=true
OPS_STORAGE_PREVIEW_ENABLED=true
OPS_STORAGE_ABORT_UPLOAD_ENABLED=true

# ==============================================================================
# 6. Messaging (BullMQ trên Redis — System Console → Messaging)
# ==============================================================================
# Trần tối đa cho số lần thử của một job (chống cấu hình retry vô hạn)
MESSAGING_MAX_ATTEMPTS_CAP=10
# Số lần xử lý tối đa mặc định của một message; hết lượt → Dead Letter
MESSAGING_MAX_ATTEMPTS=3
# exponential | fixed
MESSAGING_BACKOFF=exponential
MESSAGING_BACKOFF_DELAY_MS=1000
# Thời gian thực thi tối đa mặc định của một job trước khi bị ngắt Timeout (ms)
MESSAGING_EXECUTION_TIMEOUT_MS=60000
# Lưu giữ để tra cứu: message đã xử lý, Dead Letter, số dòng vòng đời mỗi message
MESSAGING_KEEP_COMPLETED=1000
MESSAGING_KEEP_DEAD_LETTER=1000
MESSAGING_KEEP_LIFECYCLE=50
MESSAGING_TIMEOUT_MS=2000
MESSAGING_LARGE_MESSAGE_KB=256
MESSAGING_BACKLOG_SAMPLE=2000
MESSAGING_LAG_WARN=1000
MESSAGING_LAG_CRIT=10000
MESSAGING_LAG_GROWTH_MIN=100
MESSAGING_FAILURE_RATE_PERCENT=5
MESSAGING_RULE_MIN_OPS=20
MESSAGING_PROCESSING_P95_MS=5000
MESSAGING_DLQ_WARN=100
MESSAGING_OLDEST_WAITING_MIN=10
# Thao tác từ System Console (chưa có RBAC cho /ops — nên tắt ở production). Replay có thể chạy lại nghiệp vụ.
OPS_MESSAGING_RETRY_ENABLED=true
OPS_MESSAGING_REPLAY_ENABLED=true
OPS_MESSAGING_DISCARD_ENABLED=true
# Xem payload (đã che field nhạy cảm, có audit)
OPS_MESSAGING_PAYLOAD_ENABLED=true

# ==============================================================================
# 7. Worker & Queue (Mục 7.3 — Hàng đợi công việc & Phân luồng Worker)
# ==============================================================================
# Số lượng worker xử lý đồng thời (Concurrency) theo từng loại Queue
WORKER_CONCURRENCY=5
WORKER_CRITICAL_CONCURRENCY=10
WORKER_NOTIFICATIONS_CONCURRENCY=8
WORKER_HEAVY_CONCURRENCY=2
WORKER_EVENTS_CONCURRENCY=5
# Thời gian chờ tối đa mặc định cho 1 job của worker (ms)
WORKER_JOB_TIMEOUT_MS=60000

# Ngưỡng vận hành Queue (System Console → Worker & Queue)
WORKER_QUEUE_BACKLOG_WARN=1000
WORKER_QUEUE_BACKLOG_CRIT=5000
WORKER_QUEUE_OLDEST_WAITING_MIN=10
WORKER_QUEUE_FAILURE_RATE_PERCENT=5
WORKER_QUEUE_RULE_MIN_OPS=20
WORKER_QUEUE_PROCESSING_P95_MS=5000
# Job active lâu hơn chừng này (phút) → coi là treo
WORKER_QUEUE_STALLED_MIN=10
WORKER_QUEUE_RETRY_STORM_PER_MIN=100
WORKER_QUEUE_CONCURRENCY_PERCENT=90
# Thao tác queue từ System Console. Drain xoá job đang chờ — mặc định tắt.
OPS_QUEUE_PAUSE_ENABLED=true
OPS_QUEUE_RETRY_FAILED_ENABLED=true
OPS_QUEUE_RETRY_FAILED_MAX=500
OPS_QUEUE_DRAIN_ENABLED=false
OPS_QUEUE_REQUIRE_RBAC=false

# ==============================================================================
# 8. Jobs (Mục 7.3 — Theo dõi tiến độ, Lưu trữ Job lỗi, Retry & Cancel Job)
# ==============================================================================
# Job chạy lâu hơn hệ số × P95 của loại job (tối thiểu N giây) → "chạy lâu" (chưa phải stalled)
JOBS_LONG_RUNNING_FACTOR=3
JOBS_LONG_RUNNING_MIN_SEC=60
# Job chờ lâu hơn hệ số × thời gian chờ trung bình của queue (tối thiểu N giây) → "chờ lâu"
JOBS_LONG_WAIT_FACTOR=10
JOBS_LONG_WAIT_MIN_SEC=60
JOBS_FAILURES_PER_HOUR_WARN=10
JOBS_ERROR_GROUP_WARN=5
JOBS_CRITICAL_WAIT_SEC=60
# Chỉ mục tìm kiếm (correlation / request / idempotency / field → job) và bản ghi job đã huỷ (ngày)
JOBS_INDEX_RETENTION_DAYS=7
JOBS_CANCELLED_RETENTION_DAYS=7
# Số job tối đa một lần tìm kiếm được đọc từ broker
JOBS_SEARCH_SCAN_MAX=2000
# Số lượng tối đa job thất bại lưu trong Dead-Letter Archive bền vững trên Redis
JOBS_FAILED_ARCHIVE_MAX=1000
# Thao tác job. Xoá bản ghi mặc định tắt: không hoàn tác nghiệp vụ đã chạy.
OPS_JOBS_RETRY_ENABLED=true
OPS_JOBS_BULK_RETRY_MAX=50
OPS_JOBS_CANCEL_ENABLED=true
OPS_JOBS_REMOVE_ENABLED=false
OPS_JOBS_PAYLOAD_ENABLED=true
OPS_JOBS_REQUIRE_RBAC=false

# ==============================================================================
# 9. Scheduler (Mục 7.4 — Công việc định kỳ, Distributed Lock, Cảnh báo & Lịch bị bỏ lỡ)
# ==============================================================================
# Múi giờ lịch cron (IANA; trống = múi giờ của process)
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_MAINTENANCE_CRON=*/5 * * * *
# TTL distributed lock chống chạy trùng 1 công việc định kỳ (giây)
SCHEDULER_LOCK_TTL_SEC=300
# Danh sách email người phụ trách nhận cảnh báo khi công việc định kỳ thất bại (phân tách bằng dấu phẩy)
SCHEDULER_ALERT_RECIPIENTS=ops-admin@example.com
SCHEDULER_HEARTBEAT_TIMEOUT_SEC=30
SCHEDULER_CONSECUTIVE_FAILURES_WARN=2
SCHEDULER_CONSECUTIVE_FAILURES_CRIT=5
SCHEDULER_RECENT_FAILURES_WARN=3
# Task không khai báo thời lượng dự kiến: chạy lâu hơn P95 lịch sử × hệ số (tối thiểu N giây) → có thể bị treo
SCHEDULER_CONCENTRATION_TASKS=5
# Thao tác task từ System Console (Run Now / Enable / Disable) và kiểm tra quyền RBAC
OPS_SCHEDULER_RUN_ENABLED=true
OPS_SCHEDULER_TOGGLE_ENABLED=true
OPS_SCHEDULER_REQUIRE_RBAC=false

# ==============================================================================
# 10. Logs (System Console → Logs)
# ==============================================================================
# Level khi khởi động (VERBOSE/DEBUG/INFO/WARN/ERROR); đổi tạm thời được từ Console (tự hết hạn)
LOG_LEVEL=INFO
# text: dễ đọc; json: mỗi log một dòng JSON trên stdout (cho collector như Loki / Fluent Bit)
LOG_FORMAT=text
# Số log gần nhất quét khi lọc log theo level/correlation của một runtime (trang Runtimes)
RUNTIME_LOG_RETENTION=5000
# Spike nhóm lỗi: nửa sau khoảng đang xem >= hệ số × nửa đầu và >= tối thiểu lỗi/phút
LOGS_SPIKE_FACTOR=3
LOGS_SPIKE_MIN_PER_MIN=5
LOGS_NEW_ERROR_MIN=30
LOGS_ERROR_RATE_WARN_PERCENT=5
# Thao tác. Level không hết hạn mặc định tắt để không ai quên DEBUG.
OPS_LOGS_LEVEL_ENABLED=true
OPS_LOGS_LEVEL_PERMANENT_ENABLED=false
OPS_LOGS_EXPORT_ENABLED=true
OPS_LOGS_EXPORT_MAX=10000
OPS_LOGS_DETAILS_ENABLED=true
OPS_LOGS_AUDIT_ENABLED=true

# ==============================================================================
# 11. Runtime Operations (System Console → Runtimes)
# ==============================================================================
# Tiến trình dựng lại runtime khi nó tự thoát (restart): docker | pm2 | systemd | none
RUNTIME_SUPERVISOR=none
RUNTIME_HEARTBEAT_MS=5000
RUNTIME_EVENT_RETENTION=2000
RUNTIME_MEMORY_WARN_PERCENT=85
RUNTIME_CPU_WARN_PERCENT=85
RUNTIME_EVENT_LOOP_WARN_MS=100
RUNTIME_RESTART_STORM_COUNT=3
RUNTIME_RESTART_STORM_WINDOW_MIN=10
RUNTIME_GRACEFUL_TIMEOUT_MS=30000
OPS_RUNTIME_ACTIONS_ENABLED=true

# ==============================================================================
# 12. HTTP Traffic (System Console → HTTP Traffic)
# ==============================================================================
# P95 tổng vượt mức này (ms) trong 5 phút gần nhất → cảnh báo latency
TRAFFIC_SLOW_MS=500
TRAFFIC_INTERNAL_MODULES=ops,health
TRAFFIC_ENDPOINT_P95_WARN_MS=500
TRAFFIC_ERROR_RATE_WARN_PERCENT=2
TRAFFIC_ERROR_RATE_CRIT_PERCENT=10
TRAFFIC_SPIKE_INCREASE_PERCENT=100
TRAFFIC_MIN_RPS_FOR_ALERT=1
TRAFFIC_MIN_REQUESTS_FOR_STATUS=20

# ==============================================================================
# 13. Performance (System Console → Performance)
# ==============================================================================
# Chu kỳ đánh giá rule để ghi sự kiện bắt đầu/hồi phục điểm nghẽn.
PERF_EVALUATE_MS=30000
PERF_EVENT_LOG_SIZE=1000
# Ngưỡng phát hiện điểm nghẽn (WARN = cảnh báo, CRIT = nghiêm trọng).
PERF_API_P95_MS_WARN=500
PERF_API_P95_MS_CRIT=1000
PERF_API_P99_MS_WARN=1000
PERF_API_P99_MS_CRIT=2000
PERF_ERROR_RATE_PERCENT_WARN=2
PERF_ERROR_RATE_PERCENT_CRIT=10
PERF_CPU_PERCENT_WARN=75
PERF_CPU_PERCENT_CRIT=90
PERF_CPU_SUSTAIN_MIN=2
PERF_MEMORY_PERCENT_WARN=80
PERF_MEMORY_PERCENT_CRIT=90
PERF_MEMORY_GROWTH_WINDOW_MIN=30
PERF_MEMORY_GROWTH_MB=100
PERF_EVENT_LOOP_MS_WARN=100
PERF_EVENT_LOOP_MS_CRIT=250
PERF_GC_PAUSE_MS_PER_MIN_WARN=1000
PERF_GC_PAUSE_MS_PER_MIN_CRIT=3000
PERF_DB_AVG_MS_WARN=300
PERF_DB_AVG_MS_CRIT=1000
PERF_DB_POOL_PERCENT_WARN=85
PERF_DB_POOL_PERCENT_CRIT=95
PERF_QUEUE_WAITING_WARN=500
PERF_QUEUE_WAITING_CRIT=2000
PERF_WORKER_FAILED_PERCENT_WARN=5
PERF_WORKER_FAILED_PERCENT_CRIT=20
PERF_MIN_REQUESTS=20
PERF_MIN_QUERIES=20
# Mục tiêu hiệu năng (performance budget) hiển thị ✓/✕.
PERF_BUDGET_API_P95_MS=200
PERF_BUDGET_API_P99_MS=500
PERF_BUDGET_ERROR_RATE_PERCENT=1
PERF_BUDGET_CPU_PERCENT=75
PERF_BUDGET_MEMORY_PERCENT=80

# ==============================================================================
# 14. Metrics (prom-client & Prometheus)
# ==============================================================================
# Trống = không có lịch sử (docker-compose tự đặt http://prometheus:9090 cho backend)
PROMETHEUS_URL=
PROMETHEUS_TIMEOUT_MS=3000
# Cổng /metrics của worker/scheduler (0 = mặc định 9101/9102)
METRICS_PORT=0
