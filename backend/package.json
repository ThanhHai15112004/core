{
  "name": "core",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Node.js foundation for small web applications using NestJS and Fastify",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "dev": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --exec \"tsc-alias && node dist/main.js\"",
    "start:dev": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --exec \"tsc-alias && node dist/main.js\"",
    "start:debug": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --debug --exec \"tsc-alias && node dist/main.js\"",
    "start:prod": "node dist/main.js",
    "start:api": "node dist/apps/api/main.js",
    "dev:api": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --exec \"tsc-alias && node dist/apps/api/main.js\"",
    "start:worker": "node dist/apps/worker/main.js",
    "dev:worker": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --exec \"tsc-alias && node dist/apps/worker/main.js\"",
    "start:scheduler": "node dist/apps/scheduler/main.js",
    "dev:scheduler": "npm run build && NODE_OPTIONS=\"--max-old-space-size=384\" nest start --watch --exec \"tsc-alias && node dist/apps/scheduler/main.js\"",
    "cli": "node dist/apps/cli/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=512\" jest --passWithNoTests --runInBand",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=512\" jest --testPathPattern=\"test/unit\" --runInBand",
    "test:feature": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=512\" jest --testPathPattern=\"test/feature\" --runInBand",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=512\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=512\" jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "bullmq": "^6.3.8",
    "cron": "^4.4.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts",
      "<rootDir>/test/**/*.feature-spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          },
          "tsconfig": {
            "rootDir": "./",
            "outDir": "./dist",
            "isolatedModules": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@apps/(.*)\\.js$": "<rootDir>/src/apps/$1",
      "^@apps/(.*)$": "<rootDir>/src/apps/$1",
      "^@packages/(.*)\\.js$": "<rootDir>/src/packages/$1",
      "^@packages/(.*)$": "<rootDir>/src/packages/$1",
      "^@modules/(.*)\\.js$": "<rootDir>/src/modules/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@project-modules/(.*)\\.js$": "<rootDir>/src/project-modules/$1",
      "^@project-modules/(.*)$": "<rootDir>/src/project-modules/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.module.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  }
}
