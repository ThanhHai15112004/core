{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "audit",
  "displayName": "Audit Log & Security Events",
  "version": "1.0.0",
  "description": "Module lưu trữ, tra cứu và bảo vệ tính toàn vẹn Nhật ký thao tác (Audit Log bất biến), sự kiện bảo mật và cảnh báo SIEM",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "AuditModule",
  "dependencies": ["database"],
  "permissions": ["audit.read", "audit.manage"],
  "events": {
    "published": [],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["audit_logs"]
  },
  "codeTypes": [],
  "settings": [
    {
      "key": "roles.audit_log.default_page_size",
      "groupCode": "security",
      "module": "audit",
      "namespace": "roles.audit_log",
      "name": "Số dòng mặc định mỗi trang khi tra cứu Nhật ký thao tác (Audit Log)",
      "description": "Số lượng bản ghi Audit Log trả về mặc định khi client không truyền tham số limit",
      "valueType": "NUMBER",
      "defaultValue": 20,
      "validationRules": { "min": 1, "max": 200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 42
    },
    {
      "key": "roles.audit_log.max_page_size",
      "groupCode": "security",
      "module": "audit",
      "namespace": "roles.audit_log",
      "name": "Số dòng tối đa mỗi trang khi tra cứu Nhật ký thao tác (Audit Log)",
      "description": "Giới hạn số bản ghi Audit Log tối đa được phép lấy trong một lần truy vấn phân trang",
      "valueType": "NUMBER",
      "defaultValue": 200,
      "validationRules": { "min": 10, "max": 1000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 43
    }
  ],
  "menus": [
    {
      "code": "IAM_AUDIT_LOGS",
      "name": "Nhật ký Kiểm toán (Audit Log)",
      "status": 1,
      "link": "/iam/audit-logs",
      "linkApi": "/api/v1/audit/logs",
      "type": 2,
      "parentCode": "IAM",
      "level": 2,
      "key": "roles.read",
      "numOrder": 4,
      "icon": "FileCheck",
      "position": "SIDEBAR"
    }
  ]
}
