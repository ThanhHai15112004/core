{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "auth",
  "displayName": "Authentication, Sessions & Multi-Factor Auth",
  "version": "1.0.0",
  "description": "Module xác thực tài khoản, quản lý mật khẩu, quản lý phiên đăng nhập đa thiết bị và xác thực nhiều lớp (TOTP, Email OTP, Recovery Codes)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "AuthModule",
  "dependencies": ["database", "redis", "security", "users"],
  "permissions": [
    "auth.sessions.manage",
    "auth.mfa.manage",
    "auth.settings.read",
    "auth.settings.write"
  ],
  "events": {
    "published": [
      "auth.login_succeeded",
      "auth.login_failed",
      "auth.mfa_challenged",
      "auth.mfa_verified",
      "auth.mfa_email_otp_sent",
      "auth.session_created",
      "auth.session_revoked",
      "auth.password_changed",
      "auth.password_reset_requested",
      "auth.password_reset_completed"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "auth_sessions",
      "auth_login_histories",
      "auth_mfa_configs",
      "auth_password_resets",
      "auth_security_settings",
      "auth_verification_codes",
      "auth_service_accounts",
      "auth_api_clients"
    ]
  },
  "codeTypes": [
    {
      "code": "auth.mfa_method",
      "name": "Phương thức xác thực đa nhân tố (MFA)",
      "description": "Các phương thức xác thực bước 2 được hỗ trợ trên nền tảng",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "TOTP",
          "behaviorCode": "TOTP",
          "name": "Ứng dụng Authenticator (TOTP)",
          "labels": { "vi": "Ứng dụng Authenticator (TOTP)", "en": "Authenticator App (TOTP)" },
          "badgeTone": "success",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "EMAIL_OTP",
          "behaviorCode": "EMAIL_OTP",
          "name": "Mã OTP qua Email",
          "labels": { "vi": "Mã OTP qua Email", "en": "Email OTP" },
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "RECOVERY_CODE",
          "behaviorCode": "RECOVERY_CODE",
          "name": "Mã khôi phục dự phòng",
          "labels": { "vi": "Mã khôi phục dự phòng", "en": "Recovery Code" },
          "badgeTone": "warning",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "SMS_OTP",
          "behaviorCode": "SMS_OTP",
          "name": "Mã OTP qua tin nhắn SMS",
          "labels": { "vi": "Mã OTP qua tin nhắn SMS", "en": "SMS OTP" },
          "badgeTone": "info",
          "sortOrder": 4,
          "isSystem": true
        }
      ]
    },
    {
      "code": "auth.mfa_policy",
      "name": "Chính sách bắt buộc MFA",
      "description": "Chính sách yêu cầu xác thực đa nhân tố trên toàn hệ thống",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "OPTIONAL",
          "behaviorCode": "OPTIONAL",
          "name": "Tùy chọn (Người dùng tự bật)",
          "labels": { "vi": "Tùy chọn (Người dùng tự bật)", "en": "Optional" },
          "badgeTone": "neutral",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "REQUIRED_FOR_ADMINS",
          "behaviorCode": "REQUIRED_FOR_ADMINS",
          "name": "Bắt buộc với Quản trị viên",
          "labels": { "vi": "Bắt buộc với Quản trị viên", "en": "Required for Admins" },
          "badgeTone": "warning",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "REQUIRED_FOR_ALL",
          "behaviorCode": "REQUIRED_FOR_ALL",
          "name": "Bắt buộc toàn bộ người dùng",
          "labels": { "vi": "Bắt buộc toàn bộ người dùng", "en": "Required for All Users" },
          "badgeTone": "danger",
          "sortOrder": 3,
          "isSystem": true
        }
      ]
    }
  ],
  "settingGroups": [
    {
      "code": "security",
      "module": "auth",
      "name": "Cấu hình Bảo mật & Xác thực",
      "description": "Thiết lập độ dài mật khẩu, độ phức tạp, khóa tài khoản, MFA và thời hạn phiên đăng nhập",
      "icon": "shield-lock",
      "sortOrder": 3,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "security.password.min_length",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Độ dài mật khẩu tối thiểu",
      "description": "Số ký tự tối thiểu bắt buộc khi tạo hoặc đổi mật khẩu người dùng",
      "valueType": "NUMBER",
      "defaultValue": 8,
      "validationRules": { "min": 6, "max": 128, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "security.password.require_uppercase",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc chữ cái viết hoa",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một chữ cái in hoa (A-Z)",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "security.password.require_numbers",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc chữ số",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một chữ số (0-9)",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "security.password.require_special_chars",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc ký tự đặc biệt",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một ký tự đặc biệt (!@#$%^&*...)",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "security.login.max_failed_attempts",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Số lần đăng nhập sai tối đa",
      "description": "Số lần nhập sai mật khẩu liên tiếp trước khi tạm khóa tài khoản",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "security.login.lockout_duration_minutes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Thời gian tạm khóa tài khoản (phút)",
      "description": "Số phút khóa tài khoản tự động khi vượt quá số lần đăng nhập sai",
      "valueType": "NUMBER",
      "defaultValue": 15,
      "validationRules": { "min": 1, "max": 1440, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "security.session.idle_timeout_minutes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.session",
      "name": "Thời gian chờ phiên không hoạt động (phút)",
      "description": "Tự động thu hồi phiên nếu người dùng không thao tác quá thời gian quy định",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 0, "max": 10080, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 7
    },
    {
      "key": "security.password.require_current_on_change",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Yêu cầu mật khẩu hiện tại khi đổi mật khẩu",
      "description": "Bắt buộc người dùng nhập mật khẩu hiện tại khi tự thay đổi mật khẩu",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 8
    },
    {
      "key": "security.password.disallow_user_info",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Cấm chứa thông tin cá nhân trong mật khẩu",
      "description": "Ngăn mật khẩu chứa username, email hoặc số điện thoại của tài khoản",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 9
    },
    {
      "key": "security.password.disallowed_list",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Danh sách mật khẩu bị cấm sử dụng",
      "description": "Danh sách các mật khẩu yếu hoặc phổ biến không được phép đặt",
      "valueType": "JSON",
      "defaultValue": [
        "password",
        "12345678",
        "123456789",
        "1234567890",
        "qwerty123",
        "admin123",
        "welcome123",
        "letmein123",
        "iloveyou",
        "abcd1234"
      ],
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 10
    },
    {
      "key": "security.password.prevent_reuse",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Chặn đặt lại mật khẩu cũ",
      "description": "Không cho phép người dùng tái sử dụng các mật khẩu gần nhất đã từng đặt",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 11
    },
    {
      "key": "security.password.history_limit",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Số lượng mật khẩu lịch sử lưu kiểm tra",
      "description": "Số lượng mật khẩu gần nhất không được phép đặt trùng lại",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 20, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 12
    },
    {
      "key": "security.password.revoke_sessions_on_change",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Thu hồi các phiên khác khi đổi mật khẩu",
      "description": "Tự động đăng xuất tất cả các thiết bị khác khi người dùng đổi mật khẩu",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 13
    },
    {
      "key": "security.password.reset_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Thời hạn mã/link khôi phục mật khẩu (giây)",
      "description": "Thời gian hiệu lực của mã OTP và đường dẫn đặt lại mật khẩu khi quên mật khẩu",
      "valueType": "NUMBER",
      "defaultValue": 900,
      "validationRules": { "min": 60, "max": 86400, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 14
    },
    {
      "key": "security.crypto.password_hash_algorithm",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.crypto",
      "name": "Thuật toán băm mật khẩu mặc định",
      "description": "Thuật toán băm mật khẩu người dùng (SCRYPT, PBKDF2_SHA512, PBKDF2_SHA256)",
      "valueType": "TEXT",
      "defaultValue": "SCRYPT",
      "validationRules": { "enumOptions": ["SCRYPT", "PBKDF2_SHA512", "PBKDF2_SHA256"] },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 15
    },
    {
      "key": "security.crypto.db_encryption_algorithm",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.crypto",
      "name": "Thuật toán mã hóa trường nhạy cảm DB",
      "description": "Thuật toán mã hóa dữ liệu nhạy cảm lưu trong CSDL (AES_256_GCM, CHACHA20_POLY1305, AES_256_CBC_HMAC)",
      "valueType": "TEXT",
      "defaultValue": "AES_256_GCM",
      "validationRules": {
        "enumOptions": ["AES_256_GCM", "CHACHA20_POLY1305", "AES_256_CBC_HMAC"]
      },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 16
    },
    {
      "key": "security.crypto.encrypt_fields_at_rest",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.crypto",
      "name": "Bật mã hóa dữ liệu nhạy cảm khi lưu trữ",
      "description": "Kích hoạt mã hóa các trường nhạy cảm (SĐT, giấy tờ tùy thân, bí mật TOTP) trước khi ghi xuống CSDL",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 17
    },
    {
      "key": "security.mfa.policy",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Chính sách bắt buộc xác thực đa lớp (MFA)",
      "description": "Chính sách áp dụng MFA khi đăng nhập (OPTIONAL, REQUIRED_FOR_ADMINS, REQUIRED_FOR_ALL)",
      "valueType": "TEXT",
      "defaultValue": "OPTIONAL",
      "validationRules": {
        "enumOptions": ["OPTIONAL", "REQUIRED_FOR_ADMINS", "REQUIRED_FOR_ALL"]
      },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 18
    },
    {
      "key": "security.mfa.allowed_methods",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Các phương thức MFA được phép sử dụng",
      "description": "Danh sách phương thức xác thực bước 2 được bật trên hệ thống",
      "valueType": "JSON",
      "defaultValue": ["TOTP", "EMAIL_OTP", "RECOVERY_CODE"],
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 19
    },
    {
      "key": "security.mfa.email_otp_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Thời hạn mã MFA Email OTP (giây)",
      "description": "Thời gian hiệu lực của mã OTP 6 chữ số gửi qua Email khi xác thực bước 2",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 30, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 20
    },
    {
      "key": "security.mfa.sms_otp_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Thời hạn mã MFA SMS OTP (giây)",
      "description": "Thời gian hiệu lực của mã OTP 6 chữ số gửi qua SMS khi xác thực bước 2",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 30, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 21
    },
    {
      "key": "security.mfa.trusted_device_days",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Thời hạn ghi nhớ Thiết bị tin cậy mặc định (ngày)",
      "description": "Số ngày mặc định không hỏi lại MFA trên thiết bị đã được người dùng đánh dấu tin cậy",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 1, "max": 365, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 22
    },
    {
      "key": "security.mfa.max_trusted_devices",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Số lượng Thiết bị tin cậy tối đa mỗi người dùng",
      "description": "Giới hạn số thiết bị tin cậy được lưu đồng thời cho mỗi tài khoản",
      "valueType": "NUMBER",
      "defaultValue": 20,
      "validationRules": { "min": 1, "max": 100, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 23
    },
    {
      "key": "security.mfa.recovery_code_count",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Số lượng mã khôi phục dự phòng (Recovery Codes)",
      "description": "Số lượng mã dự phòng một lần được phát hành khi người dùng kích hoạt hoặc tạo mới bộ mã khôi phục MFA",
      "valueType": "NUMBER",
      "defaultValue": 8,
      "validationRules": { "min": 4, "max": 20, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 24
    },
    {
      "key": "security.mfa.challenge_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Thời hạn phiên thử thách MFA bước 2 (giây)",
      "description": "Thời gian lưu bộ đếm số lần thử mã MFA bước 2 trước khi hết hạn",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 60, "max": 1800, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 25
    },
    {
      "key": "security.mfa.admin_role_codes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.mfa",
      "name": "Danh sách mã vai trò Quản trị viên áp dụng chính sách MFA",
      "description": "Các mã vai trò được tính là Quản trị viên khi chính sách MFA đặt là REQUIRED_FOR_ADMINS",
      "valueType": "JSON",
      "defaultValue": ["SUPER_ADMIN", "ADMIN", "SYSTEM_ADMIN", "IAM_ADMIN", "SECURITY_ADMIN"],
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 26
    },
    {
      "key": "security.step_up.ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.step_up",
      "name": "Thời hạn Step-Up Token cho thao tác nhạy cảm (giây)",
      "description": "Thời gian hiệu lực của token xác thực lại (Step-Up Authentication) trước khi thực hiện thao tác nhạy cảm",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 60, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 27
    },
    {
      "key": "security.registration.allow_email",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.registration",
      "name": "Cho phép tự đăng ký bằng Email",
      "description": "Bật hoặc tắt tính năng người dùng tự đăng ký tài khoản mới bằng địa chỉ Email",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 28
