{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "auth",
  "displayName": "Authentication, Sessions & Multi-Factor Auth",
  "version": "1.0.0",
  "description": "Module xác thực tài khoản, quản lý mật khẩu, quản lý phiên đăng nhập đa thiết bị và xác thực nhiều lớp (TOTP, Email OTP, Recovery Codes)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "AuthModule",
  "dependencies": ["database", "redis", "security", "users"],
  "permissions": [
    "auth.sessions.manage",
    "auth.mfa.manage",
    "auth.settings.read",
    "auth.settings.write"
  ],
  "events": {
    "published": [
      "auth.login_succeeded",
      "auth.login_failed",
      "auth.mfa_challenged",
      "auth.mfa_verified",
      "auth.mfa_email_otp_sent",
      "auth.session_created",
      "auth.session_revoked",
      "auth.password_changed",
      "auth.password_reset_requested",
      "auth.password_reset_completed"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["auth_sessions", "auth_mfa_configs", "auth_password_resets"]
  },
  "codeTypes": [
    {
      "code": "auth.mfa_method",
      "name": "Phương thức xác thực đa nhân tố (MFA)",
      "description": "Các phương thức xác thực bước 2 được hỗ trợ trên nền tảng",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "TOTP",
          "behaviorCode": "TOTP",
          "name": "Ứng dụng Authenticator (TOTP)",
          "labels": { "vi": "Ứng dụng Authenticator (TOTP)", "en": "Authenticator App (TOTP)" },
          "badgeTone": "success",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "EMAIL_OTP",
          "behaviorCode": "EMAIL_OTP",
          "name": "Mã OTP qua Email",
          "labels": { "vi": "Mã OTP qua Email", "en": "Email OTP" },
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "RECOVERY_CODE",
          "behaviorCode": "RECOVERY_CODE",
          "name": "Mã khôi phục dự phòng",
          "labels": { "vi": "Mã khôi phục dự phòng", "en": "Recovery Code" },
          "badgeTone": "warning",
          "sortOrder": 3,
          "isSystem": true
        }
      ]
    },
    {
      "code": "auth.mfa_policy",
      "name": "Chính sách bắt buộc MFA",
      "description": "Chính sách yêu cầu xác thực đa nhân tố trên toàn hệ thống",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "OPTIONAL",
          "behaviorCode": "OPTIONAL",
          "name": "Tùy chọn (Người dùng tự bật)",
          "labels": { "vi": "Tùy chọn (Người dùng tự bật)", "en": "Optional" },
          "badgeTone": "neutral",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "REQUIRED_FOR_ADMINS",
          "behaviorCode": "REQUIRED_FOR_ADMINS",
          "name": "Bắt buộc với Quản trị viên",
          "labels": { "vi": "Bắt buộc với Quản trị viên", "en": "Required for Admins" },
          "badgeTone": "warning",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "REQUIRED_FOR_ALL",
          "behaviorCode": "REQUIRED_FOR_ALL",
          "name": "Bắt buộc toàn bộ người dùng",
          "labels": { "vi": "Bắt buộc toàn bộ người dùng", "en": "Required for All Users" },
          "badgeTone": "danger",
          "sortOrder": 3,
          "isSystem": true
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "security.password.min_length",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Độ dài mật khẩu tối thiểu",
      "description": "Số ký tự tối thiểu bắt buộc khi tạo hoặc đổi mật khẩu người dùng",
      "valueType": "NUMBER",
      "defaultValue": 8,
      "validationRules": { "min": 6, "max": 128, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "security.password.require_uppercase",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc chữ cái viết hoa",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một chữ cái in hoa (A-Z)",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "security.password.require_numbers",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc chữ số",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một chữ số (0-9)",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "security.password.require_special_chars",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.password",
      "name": "Bắt buộc ký tự đặc biệt",
      "description": "Yêu cầu mật khẩu phải chứa ít nhất một ký tự đặc biệt (!@#$%^&*...)",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "security.login.max_failed_attempts",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Số lần đăng nhập sai tối đa",
      "description": "Số lần nhập sai mật khẩu liên tiếp trước khi tạm khóa tài khoản",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "security.login.lockout_duration_minutes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Thời gian tạm khóa tài khoản (phút)",
      "description": "Số phút khóa tài khoản tự động khi vượt quá số lần đăng nhập sai",
      "valueType": "NUMBER",
      "defaultValue": 15,
      "validationRules": { "min": 1, "max": 1440, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "security.session.idle_timeout_minutes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.session",
      "name": "Thời gian chờ phiên không hoạt động (phút)",
      "description": "Tự động thu hồi phiên nếu người dùng không thao tác quá thời gian quy định",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 1, "max": 10080, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 7
    }
  ]
}
