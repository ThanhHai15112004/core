{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "auth",
  "displayName": "Authentication & Identity Verification",
  "version": "1.0.0",
  "description": "Module điều phối đăng ký, đăng nhập, xác minh danh tính (Email/SĐT OTP) và luồng xác thực người dùng",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "AuthModule",
  "dependencies": [
    "database",
    "redis",
    "security",
    "users",
    "sessions",
    "credentials",
    "mfa",
    "machine-identities"
  ],
  "permissions": [],
  "events": {
    "published": [
      "auth.login_succeeded",
      "auth.login_failed"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "auth_verification_codes"
    ]
  },
  "codeTypes": [
    {
      "code": "auth.verification_channel",
      "module": "auth",
      "name": "Kênh xác minh danh tính",
      "description": "Các kênh gửi mã xác minh tài khoản (Email hoặc SMS OTP)",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "EMAIL",
          "behaviorCode": "EMAIL",
          "name": "Email",
          "labels": { "vi": "Email", "en": "Email" },
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "PHONE_OTP",
          "behaviorCode": "PHONE_OTP",
          "name": "Tin nhắn SMS OTP",
          "labels": { "vi": "Tin nhắn SMS OTP", "en": "SMS OTP" },
          "sortOrder": 2,
          "isSystem": true
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "security.login.max_failed_attempts",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Số lần đăng nhập sai tối đa",
      "description": "Số lần nhập sai mật khẩu liên tiếp trước khi tạm khóa tài khoản",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "security.login.lockout_duration_minutes",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.login",
      "name": "Thời gian tạm khóa tài khoản (phút)",
      "description": "Số phút khóa tài khoản tự động khi vượt quá số lần đăng nhập sai",
      "valueType": "NUMBER",
      "defaultValue": 15,
      "validationRules": { "min": 1, "max": 1440, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "security.registration.allow_email",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.registration",
      "name": "Cho phép tự đăng ký bằng Email",
      "description": "Bật hoặc tắt tính năng người dùng tự đăng ký tài khoản mới bằng địa chỉ Email",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 28
    },
    {
      "key": "security.registration.allow_phone",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.registration",
      "name": "Cho phép tự đăng ký bằng Số điện thoại",
      "description": "Bật hoặc tắt tính năng người dùng tự đăng ký tài khoản mới bằng Số điện thoại",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 29
    },
    {
      "key": "security.registration.require_email_verification",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.registration",
      "name": "Bắt buộc xác minh Email khi đăng ký",
      "description": "Yêu cầu người dùng xác nhận mã OTP hoặc link qua Email trước khi kích hoạt tài khoản",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 30
    },
    {
      "key": "security.registration.require_phone_verification",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.registration",
      "name": "Bắt buộc xác minh Số điện thoại khi đăng ký",
      "description": "Yêu cầu người dùng xác nhận mã OTP qua SMS trước khi kích hoạt tài khoản",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 31
    },
    {
      "key": "security.verification.email_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.verification",
      "name": "Thời hạn mã xác minh Email (giây)",
      "description": "Thời gian hiệu lực của mã OTP hoặc đường dẫn xác minh địa chỉ Email",
      "valueType": "NUMBER",
      "defaultValue": 900,
      "validationRules": { "min": 60, "max": 86400, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 32
    },
    {
      "key": "security.verification.phone_otp_ttl_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.verification",
      "name": "Thời hạn mã OTP xác minh SĐT (giây)",
      "description": "Thời gian hiệu lực của mã OTP gửi qua SMS để xác minh số điện thoại",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 30, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 33
    },
    {
      "key": "security.otp.max_send_count",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.otp",
      "name": "Số lần gửi mã OTP tối đa",
      "description": "Giới hạn số lần yêu cầu gửi lại mã OTP liên tiếp trong một chu kỳ xác minh",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 34
    },
    {
      "key": "security.otp.max_attempts",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.otp",
      "name": "Số lần nhập sai mã OTP tối đa",
      "description": "Số lần tối đa được phép nhập sai mã OTP (xác minh tài khoản, quên mật khẩu, MFA) trước khi hủy mã",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 20, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 35
    },
    {
      "key": "security.otp.cooldown_seconds",
      "groupCode": "security",
      "module": "auth",
      "namespace": "auth.otp",
      "name": "Thời gian chờ giữa 2 lần gửi OTP (giây)",
      "description": "Số giây tối thiểu phải chờ trước khi được yêu cầu gửi lại mã OTP mới",
      "valueType": "NUMBER",
      "defaultValue": 60,
      "validationRules": { "min": 0, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 36
    }
  ]
}
