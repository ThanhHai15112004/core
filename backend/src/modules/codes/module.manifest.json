      "description": "Cho phép tự động khởi tạo nhóm danh mục (code_types) mới khi file Excel/CSV import chứa typeCode chưa tồn tại trên hệ thống",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 31
    },
    {
      "key": "codes.import.max_rows",
      "groupCode": "system",
      "module": "codes",
      "namespace": "codes.import",
      "name": "Số dòng tối đa cho mỗi lần Import danh mục",
      "description": "Giới hạn số lượng dòng dữ liệu danh mục tối đa được phép nhập hàng loạt trong một lần thực thi",
      "valueType": "NUMBER",
      "defaultValue": 5000,
      "validationRules": { "min": 100, "max": 50000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 32
