{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "compliance",
  "displayName": "Compliance & Vendor Risk Management",
  "version": "1.0.0",
  "description": "Module tùy chọn Compliance và Quản lý nhà cung cấp (Mục 14.6): danh mục yêu cầu kiểm soát (Control, người phụ trách, tần suất), bằng chứng thực hiện (File/Log/Báo cáo/Link), lịch sử kiểm tra, quản lý nhà cung cấp (Email/SMS/Cloud/Payment/AI), đánh giá phạm vi dữ liệu được phép xử lý, nhắc rà soát hợp đồng/kiểm tra định kỳ, phương án dự phòng/thay thế và báo cáo Compliance trung lập không phụ thuộc một tiêu chuẩn duy nhất.",
  "type": "core",
  "category": "Security",
  "author": "Core Platform Team",
  "entryModule": "ComplianceModule",
  "dependencies": [
    "database",
    "security",
    "audit",
    "files",
    "reports",
    "exports",
    "notifications",
    "settings",
    "feature-flags",
    "codes",
    "sequences",
    "users",
    "organizations"
  ],
  "permissions": [
    "compliance.read",
    "compliance.manage",
    "compliance.check",
    "compliance.vendor.manage",
    "compliance.report"
  ],
  "events": {
    "published": [
      "compliance.control.saved",
      "compliance.control.deleted",
      "compliance.evidence.added",
      "compliance.evidence.deleted",
      "compliance.check.recorded",
      "compliance.vendor.saved",
      "compliance.vendor.deleted",
      "compliance.vendor.data_assessment.saved",
      "compliance.review.due",
      "compliance.contract.expiring",
      "compliance.report.generated"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "compliance_controls",
      "compliance_check_histories",
      "compliance_evidences",
      "compliance_vendors",
      "compliance_vendor_data_assessments"
    ]
  },
