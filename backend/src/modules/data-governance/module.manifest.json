  ],
  "settingGroups": [
    {
      "code": "data_governance",
      "name": "Quyền riêng tư & Quản trị dữ liệu (14.5)",
      "description": "Cấu hình SLA xử lý DSAR, phê duyệt xóa dữ liệu cá nhân, thời hạn link xuất dữ liệu và Retention mặc định",
      "icon": "shield-lock",
      "sortOrder": 45,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "data-governance.dsar.sla_days",
      "groupCode": "data_governance",
      "name": "Thời hạn SLA xử lý yêu cầu DSAR (ngày)",
      "description": "Số ngày tối đa xử lý yêu cầu xem/xuất/xóa dữ liệu cá nhân theo quy định pháp lý",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "data-governance.dsar.export_ttl_minutes",
      "groupCode": "data_governance",
      "name": "Thời hạn hiệu lực liên kết tải gói dữ liệu cá nhân (phút)",
      "description": "Số phút lưu liên kết tải xuống gói JSON/CSV của yêu cầu Xuất dữ liệu cá nhân trước khi tự hủy",
      "valueType": "NUMBER",
      "defaultValue": 1440,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "data-governance.dsar.erasure_require_approval",
      "groupCode": "data_governance",
      "name": "Bắt buộc phê duyệt trước khi xóa dữ liệu cá nhân",
      "description": "Khi bật, mọi yêu cầu xóa dữ liệu cá nhân (ERASURE) phải được DPO / Quản trị phê duyệt kèm kiểm tra ngoại lệ",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "data-governance.dsar.allow_self_approval",
      "groupCode": "data_governance",
      "name": "Cho phép tự phê duyệt yêu cầu xóa dữ liệu của chính mình",
      "description": "Mặc định tắt để đảm bảo nguyên tắc kiểm soát chéo (4-eyes) khi xóa dữ liệu",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "data-governance.retention.default_days",
      "groupCode": "data_governance",
      "name": "Thời gian lưu dữ liệu mặc định (ngày)",
      "description": "Số ngày lưu trữ mặc định khi khởi tạo mới danh mục phân loại dữ liệu",
      "valueType": "NUMBER",
      "defaultValue": 365,
      "isSystem": true,
      "sortOrder": 5
    }
  ],
  "featureFlags": [
    {
      "key": "data-governance.enabled",
      "name": "Bật Module Quyền riêng tư & Quản trị dữ liệu (14.5)",
      "description": "Cho phép bật/tắt toàn bộ chức năng Quyền riêng tư & Quản trị dữ liệu tùy theo yêu cầu pháp lý của từng dự án",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "isSystem": true
    },
    {
      "key": "data-governance.dsar.enabled",
      "name": "Bật Yêu cầu Xem / Xuất / Xóa dữ liệu cá nhân (DSAR)",
      "description": "Cho phép tạo và xử lý yêu cầu quyền chủ thể dữ liệu (Access, Export, Erasure)",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "isSystem": true
    },
    {
      "key": "data-governance.consent.enabled",
      "name": "Bật Quản lý Sự đồng ý của người dùng (Consent Management)",
      "description": "Theo dõi đồng ý và rút lại sự đồng ý theo mục đích, phiên bản chính sách và thời gian",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "isSystem": true
    },
    {
      "key": "data-governance.legal_hold.enabled",
      "name": "Bật Tạm giữ dữ liệu pháp lý (Legal Hold)",
      "description": "Cho phép đóng băng không cho xóa hoặc dọn Retention đối với dữ liệu phục vụ điều tra/pháp lý",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "isSystem": true
    }
  ],
  "sequences": [
    {
      "key": "data-governance.dsar_code",
      "name": "Mã yêu cầu dữ liệu cá nhân (DSAR)",
      "description": "Chuỗi sinh mã tự động cho yêu cầu Xem/Xuất/Xóa dữ liệu cá nhân",
      "prefix": "DSAR",
      "separator": "-",
      "dateFormat": "YYYYMMDD",
      "paddingLength": 4,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "DAILY",
      "isSystem": true
    },
    {
      "key": "data-governance.legal_hold_code",
      "name": "Mã lệnh tạm giữ pháp lý (Legal Hold)",
      "description": "Chuỗi sinh mã tự động cho lệnh tạm giữ dữ liệu không được xóa",
      "prefix": "LHOLD",
      "separator": "-",
      "dateFormat": "YYYYMMDD",
      "paddingLength": 4,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "YEARLY",
      "isSystem": true
    }
  ]
}
