      "description": "Trạng thái hiệu lực của lệnh tạm giữ dữ liệu không được xóa",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "behaviorCode": "ACTIVE",
          "name": "Đang tạm giữ",
          "labels": { "vi": "Đang tạm giữ", "en": "Active Hold" },
          "badgeTone": "danger",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "RELEASED",
          "behaviorCode": "RELEASED",
          "name": "Đã giải phóng",
          "labels": { "vi": "Đã giải phóng", "en": "Released" },
          "badgeTone": "success",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "EXPIRED",
          "behaviorCode": "EXPIRED",
          "name": "Hết hiệu lực",
