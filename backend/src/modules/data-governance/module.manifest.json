{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "data-governance",
  "displayName": "Data Privacy & Governance",
  "version": "1.0.0",
  "description": "Module tùy chọn Quyền riêng tư và Quản trị dữ liệu (Mục 14.5): phân loại dữ liệu (Public/Internal/Confidential/Restricted), đánh dấu trường nhạy cảm cho Log/Export/Phân quyền, chính sách thời gian lưu dữ liệu (Retention), yêu cầu Xem/Xuất/Xóa dữ liệu cá nhân có ngoại lệ & phê duyệt (DSAR), quản lý sự đồng ý (Consent) và tạm giữ pháp lý (Legal Hold).",
  "type": "core",
  "category": "Security",
  "author": "Core Platform Team",
  "entryModule": "DataGovernanceModule",
  "dependencies": [
    "database",
    "security",
    "logging",
    "users",
    "sessions",
    "audit",
    "files",
    "custom-fields",
    "exports",
    "settings",
    "feature-flags",
    "codes",
    "sequences"
  ],
  "permissions": [
    "data-governance.read",
    "data-governance.manage",
    "data-governance.sensitive.read",
    "data-governance.dsar.request",
    "data-governance.dsar.approve",
    "data-governance.consent.manage",
    "data-governance.legal_hold.manage"
  ],
  "events": {
    "published": [
      "data-governance.classification.updated",
      "data-governance.sensitive-field.updated",
      "data-governance.retention.executed",
      "data-governance.dsar.created",
      "data-governance.dsar.approved",
      "data-governance.dsar.rejected",
      "data-governance.dsar.completed",
      "data-governance.consent.definition.saved",
      "data-governance.consent.granted",
      "data-governance.consent.withdrawn",
      "data-governance.legal-hold.created",
      "data-governance.legal-hold.released"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "data_classifications",
      "data_sensitive_fields",
      "privacy_dsar_requests",
      "privacy_consent_definitions",
      "privacy_user_consents",
      "data_legal_holds"
    ]
  },
  "codeTypes": [
    {
      "code": "data_governance.classification_level",
      "name": "Mức phân loại dữ liệu",
      "description": "4 cấp độ phân loại bảo mật dữ liệu (Public, Internal, Confidential, Restricted)",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "PUBLIC",
          "behaviorCode": "PUBLIC",
          "name": "Công khai (Public)",
          "labels": { "vi": "Công khai (Public)", "en": "Public" },
          "badgeTone": "success",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INTERNAL",
          "behaviorCode": "INTERNAL",
          "name": "Nội bộ (Internal)",
          "labels": { "vi": "Nội bộ (Internal)", "en": "Internal" },
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "CONFIDENTIAL",
          "behaviorCode": "CONFIDENTIAL",
          "name": "Bảo mật (Confidential)",
          "labels": { "vi": "Bảo mật (Confidential)", "en": "Confidential" },
          "badgeTone": "warning",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "RESTRICTED",
          "behaviorCode": "RESTRICTED",
          "name": "Tối mật / Hạn chế nghiêm ngặt (Restricted)",
          "labels": { "vi": "Hạn chế nghiêm ngặt (Restricted)", "en": "Restricted" },
          "badgeTone": "danger",
          "sortOrder": 4,
          "isSystem": true
        }
      ]
    },
    {
      "code": "data_governance.dsar_status",
      "name": "Trạng thái yêu cầu dữ liệu cá nhân (DSAR)",
      "description": "Vòng đời xử lý yêu cầu Xem, Xuất và Xóa dữ liệu cá nhân",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
