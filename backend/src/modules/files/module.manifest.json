          "labels": { "vi": "Chờ kiểm duyệt / Quét an toàn", "en": "Pending Scan / Staging" },
          "aliases": ["PENDING", "PENDING_SCAN", "CHỜ QUÉT", "KHU VỰC CHỜ"],
