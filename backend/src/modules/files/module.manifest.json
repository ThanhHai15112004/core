{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "files",
  "displayName": "File Management & Shared Media Library",
  "version": "1.0.0",
  "description": "Module quản lý file dùng chung, tách riêng nơi lưu trữ vật lý, kiểm tra file trước khi sử dụng, đổi tên không đổi file gốc, thùng rác có thời gian chờ, khôi phục và theo dõi liên kết sử dụng file (Phase 6 - Mục 6.1)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "FilesModule",
  "dependencies": ["database", "storage", "security", "i18n"],
  "permissions": [
    "files.read",
    "files.upload",
    "files.download",
    "files.manage",
    "files.delete"
  ],
  "events": {
    "published": [
      "files.uploaded",
      "files.renamed",
      "files.trashed",
      "files.restored",
      "files.purged",
      "files.usage_attached",
      "files.usage_detached"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["file_folders", "files", "file_usages"]
  },
  "codeTypes": [
    {
      "code": "files.status",
      "name": "Trạng thái tệp tin",
      "description": "Trạng thái vòng đời của tệp tin trong kho lưu trữ dùng chung",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "behaviorCode": "ACTIVE",
          "name": "Đang hoạt động",
          "labels": { "vi": "Đang hoạt động", "en": "Active" },
          "aliases": ["ACTIVE", "HOẠT ĐỘNG", "HOAT DONG"],
          "badgeTone": "success",
          "color": "emerald",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "TRASHED",
          "behaviorCode": "TRASHED",
          "name": "Trong thùng rác",
          "labels": { "vi": "Trong thùng rác", "en": "In Trash" },
          "aliases": ["TRASH", "TRASHED", "THÙNG RÁC", "THUNG RAC"],
          "badgeTone": "warning",
          "color": "amber",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "PURGED",
          "behaviorCode": "PURGED",
          "name": "Đã xóa vĩnh viễn",
          "labels": { "vi": "Đã xóa vĩnh viễn", "en": "Purged" },
          "aliases": ["PURGED", "DELETED", "ĐÃ XÓA"],
          "badgeTone": "danger",
          "color": "red",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "MISSING",
          "behaviorCode": "MISSING",
          "name": "Mất file vật lý",
          "labels": { "vi": "Mất file vật lý", "en": "Missing File" },
          "aliases": ["MISSING", "LOST", "MẤT FILE", "MAT FILE"],
          "badgeTone": "danger",
          "color": "rose",
          "sortOrder": 4,
          "isSystem": true
        }
      ]
    },
    {
      "code": "files.category",
      "name": "Phân loại nhóm tệp tin",
      "description": "Phân nhóm định dạng tệp tin phục vụ lọc và hiển thị trong File Manager",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "IMAGE",
          "behaviorCode": "IMAGE",
          "name": "Hình ảnh",
          "labels": { "vi": "Hình ảnh", "en": "Image" },
          "aliases": ["IMAGE", "HÌNH ẢNH", "HINH ANH"],
          "badgeTone": "info",
          "color": "blue",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "VIDEO",
          "behaviorCode": "VIDEO",
          "name": "Video",
          "labels": { "vi": "Video", "en": "Video" },
          "aliases": ["VIDEO", "PHIM"],
          "badgeTone": "info",
          "color": "indigo",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "AUDIO",
          "behaviorCode": "AUDIO",
          "name": "Âm thanh",
          "labels": { "vi": "Âm thanh", "en": "Audio" },
          "aliases": ["AUDIO", "ÂM THANH", "AM THANH"],
          "badgeTone": "info",
          "color": "violet",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "DOCUMENT",
          "behaviorCode": "DOCUMENT",
          "name": "Tài liệu văn bản",
          "labels": { "vi": "Tài liệu văn bản", "en": "Document" },
          "aliases": ["DOC", "DOCUMENT", "TÀI LIỆU"],
          "badgeTone": "neutral",
          "color": "emerald",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "SPREADSHEET",
          "behaviorCode": "SPREADSHEET",
          "name": "Bảng tính & Dữ liệu",
          "labels": { "vi": "Bảng tính & Dữ liệu", "en": "Spreadsheet & Data" },
          "aliases": ["EXCEL", "CSV", "SPREADSHEET"],
          "badgeTone": "success",
          "color": "green",
          "sortOrder": 5,
          "isSystem": true
        },
        {
          "numericCode": 6,
          "code": "ARCHIVE",
          "behaviorCode": "ARCHIVE",
          "name": "Tệp nén",
          "labels": { "vi": "Tệp nén", "en": "Archive" },
          "aliases": ["ZIP", "RAR", "ARCHIVE"],
          "badgeTone": "warning",
          "color": "amber",
          "sortOrder": 6,
          "isSystem": true
        },
        {
          "numericCode": 7,
          "code": "OTHER",
          "behaviorCode": "OTHER",
          "name": "Khác",
          "labels": { "vi": "Khác", "en": "Other" },
          "aliases": ["OTHER", "KHÁC"],
          "badgeTone": "neutral",
          "color": "slate",
          "sortOrder": 7,
          "isDefault": true,
          "isSystem": true
        }
      ]
    },
    {
      "code": "files.visibility",
      "name": "Mức độ hiển thị & truy cập tệp tin",
      "description": "Quy định phạm vi kiểm tra quyền khi tải xuống hoặc xem tệp tin",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "PRIVATE",
          "behaviorCode": "PRIVATE",
          "name": "Riêng tư (Kiểm tra quyền & đơn vị)",
          "labels": { "vi": "Riêng tư (Kiểm tra quyền & đơn vị)", "en": "Private (RBAC & Scope)" },
          "aliases": ["PRIVATE", "RIÊNG TƯ"],
          "badgeTone": "warning",
          "color": "amber",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INTERNAL",
          "behaviorCode": "INTERNAL",
          "name": "Nội bộ (Người dùng đã đăng nhập)",
          "labels": { "vi": "Nội bộ (Người dùng đã đăng nhập)", "en": "Internal (Authenticated)" },
          "aliases": ["INTERNAL", "NỘI BỘ"],
          "badgeTone": "info",
          "color": "blue",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "PUBLIC",
          "behaviorCode": "PUBLIC",
          "name": "Công khai",
          "labels": { "vi": "Công khai", "en": "Public" },
          "aliases": ["PUBLIC", "CÔNG KHAI"],
          "badgeTone": "success",
          "color": "emerald",
          "sortOrder": 3,
          "isSystem": true
        }
      ]
    }
  ],
  "settingGroups": [
    {
      "code": "file",
      "module": "files",
      "name": "Cấu hình Tệp tin & Lưu trữ",
      "description": "Thiết lập dung lượng tải lên tối đa, định dạng file cho phép, hạn mức lưu trữ và chính sách thùng rác",
      "icon": "folder",
      "sortOrder": 2,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "file.upload.max_size_mb",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Dung lượng tải lên tối đa (MB)",
      "description": "Giới hạn kích thước tối đa cho một tệp tải lên hệ thống",
      "valueType": "NUMBER",
      "defaultValue": 25,
      "validationRules": { "min": 1, "max": 2048, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "file.upload.allowed_extensions",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Danh sách đuôi tệp cho phép",
      "description": "Mảng JSON các phần mở rộng tệp được phép tải lên",
      "valueType": "JSON",
      "defaultValue": [
        "pdf",
        "docx",
        "xlsx",
        "pptx",
        "png",
        "jpg",
        "jpeg",
        "gif",
        "webp",
        "csv",
        "txt",
        "json",
        "mp4",
        "webm",
        "mp3",
        "zip"
      ],
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "file.upload.max_batch_files",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Số lượng tệp tối đa mỗi lần tải lên hàng loạt",
      "description": "Giới hạn số lượng tệp tối đa được gửi trong một yêu cầu Batch Upload",
      "valueType": "NUMBER",
      "defaultValue": 20,
      "validationRules": { "min": 1, "max": 200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "file.upload.verify_magic_bytes",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Kiểm tra chữ ký nhị phân (Magic Bytes) khi tải lên",
      "description": "Bật/tắt đối chiếu chữ ký byte đầu của tệp để chặn giả mạo định dạng hoặc tệp thực thi độc hại",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "file.upload.default_visibility",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Mức hiển thị mặc định khi tải tệp lên",
      "description": "Mức độ truy cập mặc định của tệp nếu người tải không chỉ định (1: PRIVATE, 2: INTERNAL, 3: PUBLIC)",
      "valueType": "NUMBER",
      "defaultValue": 1,
      "validationRules": { "min": 1, "max": 3, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "file.trash.retention_days",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.trash",
      "name": "Thời gian lưu file trong thùng rác (Ngày)",
      "description": "Số ngày chờ trong thùng rác trước khi cho phép dọn dẹp / xóa vĩnh viễn tự động",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 1, "max": 365, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "file.storage.quota_mb",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.storage",
      "name": "Hạn mức tổng dung lượng lưu trữ (MB)",
      "description": "Tổng dung lượng lưu trữ tối đa cho phép (0 = không giới hạn, hỗ trợ cấu hình riêng theo từng đơn vị)",
      "valueType": "NUMBER",
      "defaultValue": 51200,
      "validationRules": { "min": 0, "max": 10485760, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 7
    },
    {
      "key": "file.storage.reconcile_on_list",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.storage",
      "name": "Tự động đối soát file vật lý khi xem danh sách",
      "description": "Kiểm tra sự tồn tại của đối tượng trên Storage khi liệt kê danh sách để tự động đánh dấu MISSING",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 8
    },
    {
      "key": "file.storage.key_prefix",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.storage",
      "name": "Tiền tố đường dẫn lưu trữ vật lý (Storage Key Prefix)",
      "description": "Thư mục gốc để sinh đường dẫn lưu trữ bất biến (<prefix>/YYYY/MM/DD/<uuid>.<ext>)",
      "valueType": "TEXT",
      "defaultValue": "files",
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 9
    }
  ],
  "sequences": [
    {
      "key": "files.file_code",
      "module": "files",
      "name": "Mã định danh tệp tin (File Sequence)",
      "description": "Quy tắc sinh mã tự động cho tệp tin tải lên (ví dụ: FIL-2026-000001)",
      "prefix": "FIL",
      "suffix": "",
      "separator": "-",
      "dateFormat": "YYYY",
      "paddingLength": 6,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "YEARLY",
      "scopeByUnit": false,
      "timezone": "Asia/Ho_Chi_Minh",
      "isSystem": true
    },
    {
      "key": "files.folder_code",
      "module": "files",
      "name": "Mã định danh thư mục (Folder Sequence)",
      "description": "Quy tắc sinh mã tự động cho thư mục ảo (ví dụ: FLD-2026-00001)",
      "prefix": "FLD",
      "suffix": "",
      "separator": "-",
      "dateFormat": "YYYY",
      "paddingLength": 5,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "YEARLY",
      "scopeByUnit": false,
      "timezone": "Asia/Ho_Chi_Minh",
      "isSystem": true
    }
  ],
  "menus": [
    {
      "code": "FILES_MANAGER",
      "name": "Quản lý Tệp tin & Media",
      "status": 1,
      "link": "/files",
      "linkApi": "/api/v1/files",
      "type": 2,
      "parent": null,
      "level": 1,
      "key": "files.read",
      "numOrder": 20,
      "icon": "FolderOpen",
      "position": "SIDEBAR"
    }
  ]
}
