{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "files",
  "displayName": "File Management & Shared Media Library",
  "version": "1.0.0",
  "description": "Module quản lý file dùng chung, tách riêng nơi lưu trữ vật lý, kiểm tra file trước khi sử dụng, đổi tên không đổi file gốc, thùng rác có thời gian chờ, khôi phục và theo dõi liên kết sử dụng file (Phase 6 - Mục 6.1)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "FilesModule",
  "dependencies": ["database", "storage", "security", "i18n"],
  "permissions": [
    "files.read",
    "files.upload",
    "files.download",
    "files.manage",
    "files.delete"
  ],
  "events": {
    "published": [
      "files.uploaded",
      "files.renamed",
      "files.trashed",
      "files.restored",
      "files.purged",
      "files.usage_attached",
      "files.usage_detached"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["file_folders", "files", "file_usages"]
  },
  "codeTypes": [
    {
      "code": "files.status",
