          "aliases": ["QUARANTINE", "QUARANTINED", "CÁCH LY", "MÃ ĐỘC"],
          "badgeTone": "danger",
          "color": "red",
          "sortOrder": 6,
          "isSystem": true
        }
      ]
    },
    {
