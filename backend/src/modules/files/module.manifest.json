  "settingGroups": [
    {
      "code": "file",
      "module": "files",
      "name": "Cấu hình Tệp tin & Lưu trữ",
      "description": "Thiết lập dung lượng tải lên tối đa, định dạng file cho phép, hạn mức lưu trữ và chính sách thùng rác",
      "icon": "folder",
      "sortOrder": 2,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "file.upload.max_size_mb",
      "groupCode": "file",
      "module": "files",
      "namespace": "files.upload",
      "name": "Dung lượng tải lên tối đa (MB)",
      "description": "Giới hạn kích thước tối đa cho một tệp tải lên hệ thống",
      "valueType": "NUMBER",
      "defaultValue": 25,
      "validationRules": { "min": 1, "max": 2048, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "file.upload.allowed_extensions",
      "groupCode": "file",
      "module": "files",
