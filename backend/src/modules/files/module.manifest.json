{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "files",
  "displayName": "File Management & Shared Media Library",
  "version": "1.0.0",
  "description": "Module quản lý file dùng chung, tách riêng nơi lưu trữ vật lý, kiểm tra file trước khi sử dụng, đổi tên không đổi file gốc, thùng rác có thời gian chờ, khôi phục, theo dõi liên kết sử dụng file, phân quyền chi tiết và tạo link tải tạm thời (Phase 6 - Mục 6.1 & 6.2)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "FilesModule",
  "dependencies": ["database", "storage", "security", "i18n"],
  "permissions": [
    "files.read",
    "files.upload",
    "files.download",
    "files.manage",
    "files.delete"
  ],
  "events": {
    "published": [
      "files.uploaded",
      "files.renamed",
      "files.trashed",
      "files.restored",
      "files.purged",
      "files.usage_attached",
      "files.usage_detached"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["file_folders", "files", "file_usages", "file_permissions"]
  },
  "codeTypes": [
    {
      "code": "files.status",
      "name": "Trạng thái tệp tin",
      "description": "Trạng thái vòng đời của tệp tin trong kho lưu trữ dùng chung",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "behaviorCode": "ACTIVE",
          "name": "Đang hoạt động",
          "labels": { "vi": "Đang hoạt động", "en": "Active" },
          "aliases": ["ACTIVE", "HOẠT ĐỘNG", "HOAT DONG"],
          "badgeTone": "success",
          "color": "emerald",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "TRASHED",
          "behaviorCode": "TRASHED",
          "name": "Trong thùng rác",
          "labels": { "vi": "Trong thùng rác", "en": "In Trash" },
          "aliases": ["TRASH", "TRASHED", "THÙNG RÁC", "THUNG RAC"],
          "badgeTone": "warning",
          "color": "amber",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "PURGED",
          "behaviorCode": "PURGED",
          "name": "Đã xóa vĩnh viễn",
          "labels": { "vi": "Đã xóa vĩnh viễn", "en": "Purged" },
          "aliases": ["PURGED", "DELETED", "ĐÃ XÓA"],
          "badgeTone": "danger",
          "color": "red",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "MISSING",
          "behaviorCode": "MISSING",
          "name": "Mất file vật lý",
          "labels": { "vi": "Mất file vật lý", "en": "Missing File" },
          "aliases": ["MISSING", "LOST", "MẤT FILE", "MAT FILE"],
          "badgeTone": "danger",
          "color": "rose",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "PENDING_SCAN",
