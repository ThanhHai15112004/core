{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "notification-delivery",
  "displayName": "Multi-Channel Notification Delivery (Email, SMS & Push)",
  "version": "1.0.0",
  "description": "Module 7.2 — Vận chuyển thông báo đa kênh (Email theo template, SMS qua nhà cung cấp, Web/Mobile Push Notification); theo dõi trạng thái gửi (Queued, Sent, Delivered, Failed, Suppressed); tự động gửi lại lỗi tạm thời không gửi trùng (Auto-Retry & Idempotency); danh sách dừng gửi (Suppression List); gửi hàng loạt theo batch và kiểm soát chi phí/hạn mức nhà cung cấp.",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "NotificationDeliveryModule",
  "dependencies": [
    "database",
    "security",
    "i18n",
    "messaging",
    "users",
    "codes",
    "settings",
    "feature-flags",
    "templates"
  ],
  "permissions": [
    "notification-delivery.read",
    "notification-delivery.send",
    "notification-delivery.manage"
  ],
  "database": {
    "hasMigrations": true,
    "tables": [
      "notification_deliveries",
      "notification_suppressions",
      "notification_push_subscriptions",
      "notification_quota_usages"
    ]
  },
  "codeTypes": [
    {
      "code": "notifications.delivery_status",
      "name": "Trạng thái gửi thông báo đa kênh",
      "description": "Trạng thái vận chuyển của bản tin thông báo qua các kênh Email, SMS, Push (Queued, Sent, Delivered, Failed, Suppressed)",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "QUEUED",
          "behaviorCode": "QUEUED",
          "name": "Đang chờ gửi (Queued)",
          "labels": { "vi": "Đang chờ gửi (Queued)", "en": "Queued" },
          "aliases": ["QUEUED", "PENDING", "CHỜ GỬI"],
          "badgeTone": "info",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "SENT",
          "behaviorCode": "SENT",
          "name": "Đã gửi qua nhà cung cấp (Sent)",
          "labels": { "vi": "Đã gửi (Sent)", "en": "Sent" },
          "aliases": ["SENT", "DISPATCHED", "ĐÃ GỬI"],
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "DELIVERED",
          "behaviorCode": "DELIVERED",
          "name": "Đã chuyển tới đích (Delivered)",
          "labels": { "vi": "Đã nhận (Delivered)", "en": "Delivered" },
          "aliases": ["DELIVERED", "SUCCESS", "ĐÃ NHẬN"],
          "badgeTone": "success",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "FAILED",
          "behaviorCode": "FAILED",
          "name": "Gửi thất bại (Failed)",
          "labels": { "vi": "Thất bại (Failed)", "en": "Failed" },
          "aliases": ["FAILED", "ERROR", "THẤT BẠI"],
          "badgeTone": "danger",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "SUPPRESSED",
          "behaviorCode": "SUPPRESSED",
          "name": "Dừng gửi do địa chỉ/token bị chặn (Suppressed)",
          "labels": { "vi": "Dừng gửi (Suppressed)", "en": "Suppressed" },
          "aliases": ["SUPPRESSED", "BLOCKED", "DỪNG GỬI"],
          "badgeTone": "warning",
          "sortOrder": 5,
          "isSystem": true
        }
      ]
    },
    {
      "code": "notifications.suppression_reason",
      "name": "Lý do dừng gửi thông báo (Suppression Reason)",
      "description": "Nguyên nhân địa chỉ Email, SĐT hoặc Push Token bị đưa vào danh sách dừng gửi",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "HARD_BOUNCE",
          "behaviorCode": "HARD_BOUNCE",
          "name": "Địa chỉ trả lại vĩnh viễn (Hard Bounce)",
          "labels": { "vi": "Hard Bounce (Không tồn tại)", "en": "Hard Bounce" },
          "aliases": ["HARD_BOUNCE", "BOUNCE"],
          "badgeTone": "danger",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INVALID_FORMAT",
          "behaviorCode": "INVALID_FORMAT",
          "name": "Sai định dạng địa chỉ/số điện thoại",
          "labels": { "vi": "Sai định dạng", "en": "Invalid Format" },
          "aliases": ["INVALID_FORMAT", "INVALID"],
          "badgeTone": "warning",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "UNREGISTERED_TOKEN",
          "behaviorCode": "UNREGISTERED_TOKEN",
          "name": "Push Token hết hạn hoặc đã gỡ cài đặt",
          "labels": { "vi": "Token không hợp lệ / Hết hạn", "en": "Unregistered Push Token" },
          "aliases": ["UNREGISTERED_TOKEN", "INVALID_TOKEN"],
          "badgeTone": "danger",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "UNSUBSCRIBED",
          "behaviorCode": "UNSUBSCRIBED",
          "name": "Người dùng từ chối nhận (Unsubscribed)",
          "labels": { "vi": "Đã hủy đăng ký", "en": "Unsubscribed" },
          "aliases": ["UNSUBSCRIBED", "OPT_OUT"],
          "badgeTone": "neutral",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "SPAM_COMPLAINT",
          "behaviorCode": "SPAM_COMPLAINT",
          "name": "Báo cáo thư rác (Spam Complaint)",
          "labels": { "vi": "Báo cáo Spam", "en": "Spam Complaint" },
          "aliases": ["SPAM_COMPLAINT", "SPAM"],
          "badgeTone": "danger",
          "sortOrder": 5,
          "isSystem": true
        },
        {
          "numericCode": 6,
          "code": "MANUAL_BLOCK",
          "behaviorCode": "MANUAL_BLOCK",
          "name": "Quản trị viên chặn thủ công",
          "labels": { "vi": "Chặn thủ công", "en": "Manual Block" },
          "aliases": ["MANUAL_BLOCK", "MANUAL"],
          "badgeTone": "warning",
          "sortOrder": 6,
          "isSystem": true
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "notification.email.provider",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Nhà cung cấp gửi Email (Email Provider)",
      "description": "Adapter nhà cung cấp dịch vụ gửi Email (CONSOLE, SMTP, SENDGRID, WEBHOOK)",
      "valueType": "STRING",
      "defaultValue": "CONSOLE",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 18
    },
    {
      "key": "notification.email.from_address",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Địa chỉ Email người gửi mặc định (From Address)",
      "description": "Địa chỉ hiển thị ở trường From khi gửi Email thông báo",
      "valueType": "STRING",
      "defaultValue": "no-reply@core.local",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 19
    },
    {
      "key": "notification.email.from_name",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Tên hiển thị người gửi Email (From Name)",
      "description": "Tên hiển thị kèm theo địa chỉ Email người gửi",
      "valueType": "STRING",
      "defaultValue": "Core System",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 20
    },
    {
      "key": "notification.email.provider_config_json",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Cấu hình kết nối Email Provider (SMTP/API Key)",
      "description": "Chuỗi JSON lưu thông tin xác thực SMTP/SendGrid/Webhook (mã hóa AES-256-GCM)",
      "valueType": "JSON",
      "defaultValue": {},
      "isSensitive": true,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 21
    },
    {
      "key": "notification.sms.provider",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Nhà cung cấp cổng SMS (SMS Provider Adapter)",
      "description": "Adapter nhà cung cấp dịch vụ gửi SMS (CONSOLE, VIETTEL, FPT, TWILIO, WEBHOOK)",
      "valueType": "STRING",
      "defaultValue": "CONSOLE",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 22
    },
    {
      "key": "notification.sms.sender_id",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Tên thương hiệu SMS (SMS Brandname / Sender ID)",
      "description": "Brandname hoặc đầu số hiển thị khi gửi tin nhắn SMS",
      "valueType": "STRING",
      "defaultValue": "CORE_APP",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 23
    },
    {
      "key": "notification.sms.provider_config_json",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Cấu hình kết nối SMS Provider (API Key/Secret)",
      "description": "Chuỗi JSON lưu thông tin xác thực cổng SMS (mã hóa AES-256-GCM)",
      "valueType": "JSON",
      "defaultValue": {},
      "isSensitive": true,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 24
    },
    {
      "key": "notification.push.provider",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Nhà cung cấp Push Notification (Web/Mobile Push Adapter)",
      "description": "Adapter gửi thông báo đẩy (CONSOLE, WEB_PUSH, FCM, APNS)",
      "valueType": "STRING",
      "defaultValue": "CONSOLE",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 25
    },
    {
      "key": "notification.push.provider_config_json",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.providers",
      "name": "Cấu hình khóa VAPID / FCM cho Push Notification",
      "description": "Chuỗi JSON lưu VAPID keys hoặc FCM credentials (mã hóa AES-256-GCM)",
      "valueType": "JSON",
      "defaultValue": {},
      "isSensitive": true,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 26
    },
    {
      "key": "notification.dispatch.batch_size",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.dispatch",
      "name": "Kích thước lô gửi thông báo đa kênh (Batch Size)",
      "description": "Số lượng bản tin xử lý trong mỗi lô (batch) khi gửi hàng loạt qua Email, SMS, Push",
      "valueType": "NUMBER",
      "defaultValue": 100,
      "validationRules": { "min": 1, "max": 5000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 27
    },
    {
      "key": "notification.dispatch.rate_limit_per_sec",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.dispatch",
      "name": "Giới hạn tốc độ gửi tối đa mỗi giây (Rate Limit/s)",
      "description": "Số lượng lệnh gửi tối đa mỗi giây tới nhà cung cấp để tránh nghẽn hệ thống",
      "valueType": "NUMBER",
      "defaultValue": 50,
      "validationRules": { "min": 1, "max": 10000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 28
    },
    {
      "key": "notification.retry.enabled",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.retry",
      "name": "Bật tự động gửi lại khi gặp lỗi tạm thời (Auto-Retry)",
      "description": "Tự động lập lịch gửi lại với Exponential Backoff khi gặp lỗi mạng/timeout/rate-limit và đảm bảo không gửi trùng",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 29
    },
    {
      "key": "notification.retry.max_attempts",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.retry",
      "name": "Số lần thử gửi lại tối đa (Max Attempts)",
      "description": "Tổng số lần thử gửi tối đa trước khi chuyển sang trạng thái FAILED vĩnh viễn",
      "valueType": "NUMBER",
      "defaultValue": 3,
      "validationRules": { "min": 1, "max": 10, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 30
    },
    {
      "key": "notification.retry.base_delay_sec",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.retry",
      "name": "Thời gian chờ cơ sở giữa các lần gửi lại (Giây)",
      "description": "Thời gian chờ cơ sở tính theo Exponential Backoff (delay = base * 2^(attempt-1))",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 1, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 31
    },
    {
      "key": "notification.suppression.auto_suppress_on_permanent_failure",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.suppression",
      "name": "Tự động dừng gửi khi địa chỉ hoặc token không hợp lệ",
      "description": "Tự động thêm Email hard-bounce, SĐT sai hoặc Push Token hết hạn vào Suppression List để giảm lỗi lặp",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 32
    },
    {
      "key": "notification.quota.currency",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Đơn vị tiền tệ tính chi phí thông báo",
      "description": "Mã tiền tệ dùng để thống kê chi phí gửi SMS/Email (VND, USD)",
      "valueType": "STRING",
      "defaultValue": "VND",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 33
    },
    {
      "key": "notification.quota.hard_stop_on_exceed",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Dừng gửi khi chạm trần Quota hoặc Ngân sách nhà cung cấp",
      "description": "Khi bật, từ chối gửi kênh ngoài nếu vượt hạn mức số lượng ngày hoặc ngân sách tháng",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 34
    },
    {
      "key": "notification.sms.daily_quota",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Hạn mức số bản tin SMS tối đa mỗi ngày (SMS Daily Quota)",
      "description": "Số lượng segment SMS tối đa được phép gửi trong 1 ngày (0 = không giới hạn)",
      "valueType": "NUMBER",
      "defaultValue": 10000,
      "validationRules": { "min": 0, "max": 10000000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 35
    },
    {
      "key": "notification.sms.monthly_budget",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Ngân sách chi phí SMS tối đa mỗi tháng (SMS Monthly Budget)",
      "description": "Tổng chi phí SMS tối đa được phép chi tiêu trong 1 tháng (0 = không giới hạn)",
      "valueType": "NUMBER",
      "defaultValue": 5000000,
      "validationRules": { "min": 0, "max": 10000000000 },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 36
    },
    {
      "key": "notification.sms.cost_per_segment",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Đơn giá ước tính trên mỗi bản tin SMS (Cost per Segment)",
      "description": "Đơn giá tính cước cho 1 segment SMS chuẩn (GSM-7 160 ký tự hoặc Unicode 70 ký tự)",
      "valueType": "NUMBER",
      "defaultValue": 800,
      "validationRules": { "min": 0, "max": 1000000 },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 37
    },
    {
      "key": "notification.email.daily_quota",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Hạn mức số lượng Email tối đa mỗi ngày (Email Daily Quota)",
      "description": "Số lượng Email tối đa được phép gửi trong 1 ngày (0 = không giới hạn)",
      "valueType": "NUMBER",
      "defaultValue": 50000,
      "validationRules": { "min": 0, "max": 10000000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 38
    },
    {
      "key": "notification.email.cost_per_message",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Đơn giá ước tính trên mỗi Email gửi đi",
      "description": "Chi phí ước tính cho mỗi bức thư điện tử gửi qua nhà cung cấp",
      "valueType": "NUMBER",
      "defaultValue": 20,
      "validationRules": { "min": 0, "max": 100000 },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 39
    },
    {
      "key": "notification.push.daily_quota",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Hạn mức số lượng Push Notification tối đa mỗi ngày",
      "description": "Số lượng bản tin Push tối đa được phép gửi trong 1 ngày (0 = không giới hạn)",
      "valueType": "NUMBER",
      "defaultValue": 100000,
      "validationRules": { "min": 0, "max": 100000000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 40
    },
    {
      "key": "notification.push.cost_per_message",
      "groupCode": "notification",
      "module": "notification-delivery",
      "namespace": "notifications.quota",
      "name": "Đơn giá ước tính trên mỗi Push Notification",
      "description": "Chi phí ước tính trên mỗi lượt gửi thông báo đẩy",
      "valueType": "NUMBER",
      "defaultValue": 0,
      "validationRules": { "min": 0, "max": 100000 },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 41
    }
  ],
