{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "outbox",
  "displayName": "Transactional Outbox",
  "version": "1.0.0",
  "description": "Module quản lý Transactional Outbox (11.2): Lưu Domain Event cùng transaction nghiệp vụ, Worker đọc & gửi an toàn ra Queue/Broker với lease lock, retry giới hạn + exponential backoff, Dead Letter điều tra, giám sát độ trễ/tồn đọng kèm cảnh báo, phát lại có quyền & audit và tự động dọn event cũ theo chính sách.",
  "type": "core",
  "category": "Reliability",
  "author": "Core Platform Team",
  "entryModule": "OutboxModule",
  "dependencies": ["database", "messaging", "security", "settings", "codes", "notifications", "audit"],
  "permissions": [
    "outbox.read",
    "outbox.replay",
    "outbox.manage"
  ],
  "codeTypes": [
    {
      "code": "outbox.event_status",
      "name": "Trạng thái Outbox Event",
      "description": "Vòng đời xử lý và giao nhận một bản ghi sự kiện trong bảng Transactional Outbox",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "PENDING",
          "name": "Đang chờ gửi",
          "labels": { "vi": "Đang chờ gửi", "en": "Pending" },
          "behaviorCode": "PENDING",
          "badgeTone": "info",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "PROCESSING",
          "name": "Đang xử lý",
          "labels": { "vi": "Đang xử lý", "en": "Processing" },
          "behaviorCode": "PROCESSING",
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "PUBLISHED",
          "name": "Đã gửi thành công",
          "labels": { "vi": "Đã gửi", "en": "Published" },
          "behaviorCode": "PUBLISHED",
          "badgeTone": "success",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "FAILED",
          "name": "Lỗi tạm thời (chờ thử lại)",
          "labels": { "vi": "Gửi lỗi", "en": "Failed" },
          "behaviorCode": "FAILED",
          "badgeTone": "warning",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "DEAD_LETTER",
          "name": "Dead Letter (lỗi kéo dài)",
          "labels": { "vi": "Dead Letter", "en": "Dead Letter" },
          "behaviorCode": "DEAD_LETTER",
          "badgeTone": "danger",
          "sortOrder": 5,
          "isSystem": true
        }
      ]
    }
  ],
  "settingGroups": [
    {
      "code": "outbox",
      "name": "Transactional Outbox",
      "description": "Cấu hình Worker đọc Outbox, giới hạn retry/backoff, ngưỡng cảnh báo tồn đọng độ trễ và chính sách dọn event cũ",
      "icon": "Inbox",
      "sortOrder": 69,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "outbox.max_retries",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.delivery",
      "name": "Số lần thử lại tối đa trước khi đưa vào Dead Letter",
      "description": "Giới hạn số lần Worker gửi lại event lỗi trước khi chuyển sang trạng thái DEAD_LETTER (tối đa 10)",
      "valueType": "NUMBER",
      "defaultValue": 5,
      "validationRules": { "min": 1, "max": 10, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "outbox.retry_base_delay_ms",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.delivery",
      "name": "Độ trễ nền cho Exponential Backoff (ms)",
      "description": "Thời gian chờ cơ sở trước lần thử lại đầu tiên của event lỗi tạm thời",
      "valueType": "NUMBER",
      "defaultValue": 5000,
      "validationRules": { "min": 500, "max": 300000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "outbox.retry_max_delay_ms",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.delivery",
      "name": "Độ trễ trần khi thử lại (ms)",
      "description": "Giới hạn tối đa khoảng chờ giữa các lần retry theo Exponential Backoff",
      "valueType": "NUMBER",
      "defaultValue": 300000,
      "validationRules": { "min": 5000, "max": 3600000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "outbox.poll_interval_ms",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.worker",
      "name": "Chu kỳ Worker quét bảng Outbox (ms)",
      "description": "Khoảng thời gian giữa các vòng đọc Outbox khi không có sự kiện tồn đọng",
      "valueType": "NUMBER",
      "defaultValue": 2000,
      "validationRules": { "min": 250, "max": 60000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "outbox.batch_size",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.worker",
      "name": "Kích thước lô Worker đọc mỗi lượt",
      "description": "Số bản ghi Outbox tối đa một Worker giữ lease và gửi trong một lượt",
      "valueType": "NUMBER",
      "defaultValue": 50,
      "validationRules": { "min": 1, "max": 500, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "outbox.lease_timeout_ms",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.worker",
      "name": "Thời hạn khóa lease xử lý của Worker (ms)",
      "description": "Quá thời hạn này mà Worker chưa hoàn tất, bản ghi PROCESSING sẽ được tự động thu hồi để Worker khác xử lý",
      "valueType": "NUMBER",
      "defaultValue": 60000,
      "validationRules": { "min": 5000, "max": 600000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 6
    },
    {
