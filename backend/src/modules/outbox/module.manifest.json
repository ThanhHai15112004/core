      "description": "Độ tuổi của event chưa gửi cũ nhất vượt ngưỡng này sẽ kích hoạt cảnh báo Warning",
      "valueType": "NUMBER",
      "defaultValue": 60,
      "validationRules": { "min": 5, "max": 86400, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 9
    },
    {
      "key": "outbox.lag_crit_age_sec",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.monitoring",
      "name": "Ngưỡng nghiêm trọng độ trễ Event cũ nhất (giây - Critical)",
      "description": "Độ tuổi của event chưa gửi cũ nhất vượt ngưỡng này sẽ kích hoạt cảnh báo Critical",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 10, "max": 86400, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 10
    },
    {
      "key": "outbox.dead_letter_warn_count",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.monitoring",
