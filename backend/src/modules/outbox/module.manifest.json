      "module": "outbox",
      "namespace": "outbox.monitoring",
      "name": "Ngưỡng cảnh báo số Event tồn đọng (Warning)",
      "description": "Số lượng event PENDING + FAILED đạt ngưỡng này sẽ kích hoạt cảnh báo tồn đọng mức Warning",
      "valueType": "NUMBER",
      "defaultValue": 100,
      "validationRules": { "min": 1, "max": 100000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 7
    },
    {
      "key": "outbox.lag_crit_count",
      "groupCode": "outbox",
      "module": "outbox",
      "namespace": "outbox.monitoring",
