      "description": "Giới hạn số dòng xóa mỗi lượt để tránh khóa bảng lâu trên DB lớn",
      "valueType": "NUMBER",
      "defaultValue": 1000,
      "validationRules": { "min": 50, "max": 10000, "integerOnly": true },
