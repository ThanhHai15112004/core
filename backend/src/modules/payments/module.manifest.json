{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "payments",
  "displayName": "Payments (Payment Port & Reconciliation)",
  "version": "1.0.0",
  "description": "Cổng thanh toán trung lập nhà cung cấp (10.5): Cấu trúc yêu cầu & kết quả thanh toán thống nhất, adapter Sandbox/VNPay/MoMo/Stripe, chống tạo trùng bằng Idempotency Key, xác minh chữ ký/số tiền/mã giao dịch callback, hoàn tiền toàn phần/một phần, lưu lịch sử và đối soát 2 chiều.",
  "type": "core",
  "category": "Integrations",
  "author": "Core Platform Team",
  "entryModule": "PaymentsModule",
  "dependencies": [
    "database",
    "security",
    "http-client",
    "settings",
    "codes",
    "sequences",
    "audit"
  ],
  "permissions": [
    "payments.read",
    "payments.create",
    "payments.manage",
    "payments.refund",
    "payments.reconcile"
  ],
  "codeTypes": [
    {
      "code": "payments.provider_status",
