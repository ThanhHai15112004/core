      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "name": "Đang hoạt động",
          "labels": { "vi": "Đang hoạt động", "en": "Active" },
          "behaviorCode": "ACTIVE",
          "badgeTone": "success",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INACTIVE",
          "name": "Tạm tắt",
          "labels": { "vi": "Tạm tắt", "en": "Inactive" },
          "behaviorCode": "INACTIVE",
          "badgeTone": "neutral",
          "sortOrder": 2,
          "isSystem": true
        }
      ]
    },
    {
      "code": "payments.transaction_status",
