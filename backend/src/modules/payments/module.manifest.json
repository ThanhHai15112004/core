          "behaviorCode": "REFUNDED",
          "badgeTone": "neutral",
          "sortOrder": 8,
          "isSystem": true
        }
      ]
    },
    {
      "code": "payments.reconciliation_discrepancy",
      "name": "Trạng thái đối soát thanh toán",
      "description": "Phân loại kết quả so sánh giữa dữ liệu nội bộ và cổng thanh toán",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
