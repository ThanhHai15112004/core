          "behaviorCode": "ACTIVE",
          "badgeTone": "success",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "PAUSED",
          "name": "Đang tạm dừng",
          "labels": { "vi": "Đang tạm dừng", "en": "Paused" },
          "behaviorCode": "PAUSED",
          "badgeTone": "warning",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "DISABLED",
          "name": "Vô hiệu hóa",
          "labels": { "vi": "Vô hiệu hóa", "en": "Disabled" },
          "behaviorCode": "DISABLED",
          "badgeTone": "neutral",
          "sortOrder": 3,
          "isSystem": true
