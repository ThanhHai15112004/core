{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "provider-registry",
  "displayName": "Provider Registry & Routing Control Plane",
  "version": "1.0.0",
  "description": "Quản lý nhà cung cấp hạ tầng (10.6): Đăng ký nhà cung cấp theo loại (Email, SMS, Payment, Storage, Identity), cấu hình Primary/Fallback theo policy, chọn nhà cung cấp theo đơn vị, kiểm tra sức khỏe (Healthy/Degraded/Down), theo dõi độ trễ & tỷ lệ lỗi trên dashboard, tạm dừng không cần sửa code và ghi lịch sử audit thay đổi.",
  "type": "core",
  "category": "Integrations",
  "author": "Core Platform Team",
  "entryModule": "ProviderRegistryModule",
  "dependencies": [
    "database",
    "security",
    "http-client",
    "settings",
    "codes",
    "audit"
  ],
  "permissions": [
    "provider-registry.read",
    "provider-registry.manage",
    "provider-registry.health"
  ],
  "codeTypes": [
    {
