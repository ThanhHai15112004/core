          "behaviorCode": "DEGRADED",
          "badgeTone": "warning",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "DOWN",
          "name": "Ngưng hoạt động (Down)",
