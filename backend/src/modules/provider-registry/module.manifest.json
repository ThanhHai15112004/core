      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "EMAIL",
          "name": "Email Provider",
          "labels": { "vi": "Nhà cung cấp Email", "en": "Email Provider" },
          "behaviorCode": "EMAIL",
          "badgeTone": "info",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "SMS",
          "name": "SMS Provider",
          "labels": { "vi": "Nhà cung cấp SMS", "en": "SMS Provider" },
          "behaviorCode": "SMS",
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "PAYMENT",
          "name": "Payment Provider",
          "labels": { "vi": "Cổng thanh toán", "en": "Payment Provider" },
          "behaviorCode": "PAYMENT",
          "badgeTone": "success",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "STORAGE",
          "name": "Storage Provider",
          "labels": { "vi": "Lưu trữ tệp (Storage)", "en": "Storage Provider" },
          "behaviorCode": "STORAGE",
          "badgeTone": "neutral",
          "sortOrder": 4,
          "isSystem": true
        },
        {
          "numericCode": 5,
          "code": "IDENTITY",
          "name": "Identity Provider",
          "labels": { "vi": "Định danh (OAuth/OIDC)", "en": "Identity Provider" },
          "behaviorCode": "IDENTITY",
          "badgeTone": "warning",
          "sortOrder": 5,
          "isSystem": true
        }
      ]
    },
