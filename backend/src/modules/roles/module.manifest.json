{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "roles",
  "displayName": "Roles & RBAC Management",
  "version": "1.0.0",
  "description": "Module quản lý Vai trò (Roles), ánh xạ Quyền hạn cho Vai trò (role_permissions) và Gán Vai trò cho Người dùng (user_roles)",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "RolesModule",
  "dependencies": ["database", "permissions", "audit"],
  "permissions": ["roles.read", "roles.manage"],
  "events": {
    "published": ["role.created", "role.updated", "role.deleted", "role.permissions_updated"],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": ["roles", "role_permissions", "user_roles"]
  },
  "codeTypes": [
    {
      "code": "roles.status",
      "name": "Trạng thái vai trò",
      "description": "Trạng thái kích hoạt của vai trò RBAC",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "behaviorCode": "ACTIVE",
          "name": "Đang hoạt động",
          "labels": { "vi": "Đang hoạt động", "en": "Active" },
          "badgeTone": "success",
          "color": "emerald",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INACTIVE",
          "behaviorCode": "INACTIVE",
          "name": "Ngừng hoạt động",
          "labels": { "vi": "Ngừng hoạt động", "en": "Inactive" },
          "badgeTone": "warning",
          "color": "slate",
          "sortOrder": 2,
          "isSystem": true
        }
      ]
    },
    {
      "code": "roles.data_scope",
      "name": "Phạm vi dữ liệu (Data Scope)",
      "description": "Cấp độ phạm vi truy cập dữ liệu gắn với vai trò (Hybrid Anchor)",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "ALL",
          "behaviorCode": "ALL",
          "name": "Toàn hệ thống",
          "labels": { "vi": "Toàn hệ thống", "en": "All System Data" },
          "aliases": ["GLOBAL", "SYSTEM", "TOÀN HỆ THỐNG"],
          "badgeTone": "danger",
          "color": "purple",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "ORG_UNIT",
          "behaviorCode": "ORG_UNIT",
          "name": "Theo đơn vị / chi nhánh / phòng ban",
          "labels": {
            "vi": "Theo đơn vị / chi nhánh / phòng ban",
            "en": "Organization Unit / Department"
          },
          "aliases": ["ORGANIZATION_UNIT", "UNIT", "BRANCH", "DEPARTMENT", "DEPT", "TEAM"],
          "badgeTone": "info",
          "color": "indigo",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "SUBORDINATES",
          "behaviorCode": "SUBORDINATES",
          "name": "Theo cấp dưới quản lý",
          "labels": { "vi": "Theo cấp dưới quản lý", "en": "Subordinates" },
          "aliases": ["MANAGER", "SUBORDINATE", "TEAM_SUBORDINATES"],
          "badgeTone": "warning",
          "color": "teal",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "SELF",
          "behaviorCode": "SELF",
          "name": "Chỉ dữ liệu cá nhân",
          "labels": { "vi": "Chỉ dữ liệu cá nhân", "en": "Own Data Only (Self)" },
          "aliases": ["PERSONAL", "OWN", "ME"],
          "badgeTone": "neutral",
          "color": "slate",
          "sortOrder": 4,
          "isDefault": true,
          "isSystem": true
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "roles.data_scope.all_allowed_role_patterns",
      "groupCode": "security",
      "module": "roles",
      "namespace": "roles.data_scope",
      "name": "Mẫu mã vai trò được phép gán Phạm vi dữ liệu Toàn hệ thống (ALL)",
      "description": "Danh sách mã vai trò hoặc mẫu tiền tố (kết thúc bằng *) được phép gán DATA_SCOPE.ALL mà không cần quyền cấp hệ thống",
      "valueType": "JSON",
      "defaultValue": [
        "super_admin",
        "admin",
        "root",
        "auditor",
        "admin_*",
        "super_*",
        "system_*",
        "auditor_*"
      ],
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 40
    },
    {
      "key": "roles.data_scope.all_allowed_permissions",
      "groupCode": "security",
      "module": "roles",
      "namespace": "roles.data_scope",
      "name": "Danh sách quyền hạn cho phép gán Phạm vi dữ liệu Toàn hệ thống (ALL)",
      "description": "Danh sách mã quyền hoặc nhóm quyền (kết thúc bằng *) cho phép vai trò tùy chỉnh được nhận DATA_SCOPE.ALL",
      "valueType": "JSON",
      "defaultValue": [
        "system.full_access",
        "data_scope.all",
        "roles.manage",
        "system.*"
      ],
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 41
    }
  ],
  "menus": [
    {
      "code": "IAM_ROLES",
      "name": "Vai trò & Phân quyền",
      "status": 1,
      "link": "/iam/roles",
      "linkApi": "/api/v1/roles",
      "type": 2,
      "parentCode": "IAM",
      "level": 2,
      "key": "roles.read",
      "numOrder": 2,
      "icon": "KeyRound",
      "position": "SIDEBAR"
    }
  ]
}
