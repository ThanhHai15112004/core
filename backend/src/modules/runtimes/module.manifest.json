{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "runtimes",
  "displayName": "Runtime Operations",
  "version": "1.0.0",
  "description": "Module theo dõi, điều khiển các runtime API / Worker / Scheduler / CLI và chính sách Autoscaling (min/max instance, cooldown, HPA)",
  "type": "core",
  "category": "operations",
  "author": "Core Platform Team",
  "entryModule": "RuntimesModule",
  "dependencies": ["redis", "runtime", "config", "settings", "queue", "database", "metrics"],
  "permissions": [],
  "settingGroups": [
    {
      "code": "autoscaling",
      "module": "runtimes",
      "name": "Cấu hình Autoscaling (API & Worker)",
      "description": "Số lượng instance tối thiểu/tối đa, thời gian chờ sau khi scale (cooldown), ngưỡng mục tiêu CPU/RAM/In-flight/Queue Backlog và ngân sách kết nối Database",
      "icon": "Cpu",
      "sortOrder": 16,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "autoscaling.enabled",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.general",
      "name": "Bật đánh giá chính sách Autoscaling",
      "description": "Bật/tắt chế độ đánh giá và đề xuất số lượng instance theo tải thực tế",
      "valueType": "BOOLEAN",
      "defaultValue": true,
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "autoscaling.tolerance_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.general",
      "name": "Dải chống nhiễu Autoscaling (%)",
      "description": "Chênh lệch phần trăm quanh ngưỡng mục tiêu không kích hoạt scale (mặc định 10%, tương tự Kubernetes HPA tolerance)",
      "valueType": "NUMBER",
      "defaultValue": 10,
      "validationRules": { "min": 0, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "autoscaling.api.min_replicas",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Số instance tối thiểu",
      "description": "Số lượng pod/instance API tối thiểu luôn duy trì (không bao giờ scale xuống thấp hơn)",
      "valueType": "NUMBER",
      "defaultValue": 1,
      "validationRules": { "min": 1, "max": 200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "autoscaling.api.max_replicas",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Số instance tối đa",
      "description": "Giới hạn trần số lượng instance API để tránh scale không kiểm soát và cạn kiệt DB connections",
      "valueType": "NUMBER",
      "defaultValue": 10,
      "validationRules": { "min": 1, "max": 500, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "autoscaling.api.scale_up_cooldown_sec",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Thời gian chờ sau khi Scale Up (giây)",
      "description": "Thời gian ổn định (stabilization window) trước khi tiếp tục tăng thêm instance API",
      "valueType": "NUMBER",
      "defaultValue": 60,
      "validationRules": { "min": 0, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "autoscaling.api.scale_down_cooldown_sec",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Thời gian chờ trước khi Scale Down (giây)",
      "description": "Thời gian chờ đủ dài để tránh tăng giảm liên tục (flapping) sau khi tải giảm",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 0, "max": 7200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "autoscaling.api.scale_up_max_step",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Bước tăng tối đa mỗi lần Scale Up",
      "description": "Số instance API tối đa được phép tăng thêm trong mỗi chu kỳ scale-up",
      "valueType": "NUMBER",
      "defaultValue": 2,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 7
    },
    {
      "key": "autoscaling.api.scale_down_max_step",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Bước giảm tối đa mỗi lần Scale Down",
      "description": "Số instance API tối đa được phép giảm trong mỗi chu kỳ scale-down",
      "valueType": "NUMBER",
      "defaultValue": 1,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 8
    },
    {
      "key": "autoscaling.api.target_cpu_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Ngưỡng mục tiêu CPU (%)",
      "description": "Mức sử dụng CPU trung bình mục tiêu để kích hoạt autoscaling API",
      "valueType": "NUMBER",
      "defaultValue": 70,
      "validationRules": { "min": 10, "max": 95, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 9
    },
    {
      "key": "autoscaling.api.target_memory_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Ngưỡng mục tiêu RAM (%)",
      "description": "Mức sử dụng RAM trung bình mục tiêu so với cgroup/V8 limit để kích hoạt autoscaling API",
      "valueType": "NUMBER",
      "defaultValue": 75,
      "validationRules": { "min": 10, "max": 95, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 10
    },
    {
      "key": "autoscaling.api.target_in_flight",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.api",
      "name": "API — Số request đang xử lý mục tiêu / instance",
      "description": "Ngưỡng trung bình `http_requests_in_flight` trên mỗi instance API để scale theo lưu lượng thực",
      "valueType": "NUMBER",
      "defaultValue": 100,
      "validationRules": { "min": 1, "max": 100000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 11
    },
    {
      "key": "autoscaling.worker.min_replicas",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Số instance tối thiểu",
      "description": "Số lượng instance Worker tối thiểu luôn duy trì xử lý hàng đợi",
      "valueType": "NUMBER",
      "defaultValue": 1,
      "validationRules": { "min": 1, "max": 200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 12
    },
    {
      "key": "autoscaling.worker.max_replicas",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Số instance tối đa",
      "description": "Giới hạn trần số lượng instance Worker để bảo vệ Redis và Database",
      "valueType": "NUMBER",
      "defaultValue": 8,
      "validationRules": { "min": 1, "max": 500, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 13
    },
    {
      "key": "autoscaling.worker.scale_up_cooldown_sec",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Thời gian chờ sau khi Scale Up (giây)",
      "description": "Thời gian ổn định trước khi tăng thêm instance Worker khi backlog tăng cao",
      "valueType": "NUMBER",
      "defaultValue": 30,
      "validationRules": { "min": 0, "max": 3600, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 14
    },
    {
      "key": "autoscaling.worker.scale_down_cooldown_sec",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Thời gian chờ trước khi Scale Down (giây)",
      "description": "Thời gian ổn định trước khi giảm bớt instance Worker khi hàng đợi đã vơi",
      "valueType": "NUMBER",
      "defaultValue": 300,
      "validationRules": { "min": 0, "max": 7200, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 15
    },
    {
      "key": "autoscaling.worker.scale_up_max_step",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Bước tăng tối đa mỗi lần Scale Up",
      "description": "Số instance Worker tối đa được tăng thêm trong mỗi chu kỳ scale-up",
      "valueType": "NUMBER",
      "defaultValue": 2,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 16
    },
    {
      "key": "autoscaling.worker.scale_down_max_step",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Bước giảm tối đa mỗi lần Scale Down",
      "description": "Số instance Worker tối đa được giảm trong mỗi chu kỳ scale-down",
      "valueType": "NUMBER",
      "defaultValue": 1,
      "validationRules": { "min": 1, "max": 50, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 17
    },
    {
      "key": "autoscaling.worker.target_cpu_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Ngưỡng mục tiêu CPU (%)",
      "description": "Mức CPU trung bình mục tiêu trên mỗi instance Worker",
      "valueType": "NUMBER",
      "defaultValue": 75,
      "validationRules": { "min": 10, "max": 95, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 18
    },
    {
      "key": "autoscaling.worker.target_memory_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Ngưỡng mục tiêu RAM (%)",
      "description": "Mức RAM trung bình mục tiêu trên mỗi instance Worker",
      "valueType": "NUMBER",
      "defaultValue": 80,
      "validationRules": { "min": 10, "max": 95, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 19
    },
    {
      "key": "autoscaling.worker.target_backlog",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.worker",
      "name": "Worker — Queue backlog mục tiêu / instance",
      "description": "Số lượng job backlog (`core_queue_backlog_total`) mục tiêu trên mỗi instance Worker",
      "valueType": "NUMBER",
      "defaultValue": 50,
      "validationRules": { "min": 1, "max": 1000000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 20
    },
    {
      "key": "autoscaling.db.max_connections_budget",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.database",
      "name": "Database — Ngân sách kết nối tối đa khi scale",
      "description": "Tổng số kết nối Database an toàn cho toàn bộ API + Worker instances (dùng để cảnh báo nguy cơ cạn pool khi tăng maxReplicas)",
      "valueType": "NUMBER",
      "defaultValue": 150,
      "validationRules": { "min": 10, "max": 100000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 21
    },
    {
      "key": "autoscaling.db.warn_utilization_percent",
      "groupCode": "autoscaling",
      "module": "runtimes",
      "namespace": "autoscaling.database",
      "name": "Database — Ngưỡng cảnh báo tỷ lệ ngân sách kết nối (%)",
      "description": "Cảnh báo khi dự báo `(maxApi + maxWorker) × DB_MAX_CONNECTIONS` đạt tỷ lệ phần trăm này so với ngân sách DB",
      "valueType": "NUMBER",
      "defaultValue": 80,
      "validationRules": { "min": 10, "max": 100, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 22
    }
  ],
  "events": {},
  "database": {
    "hasMigrations": false,
    "tables": []
  }
}
