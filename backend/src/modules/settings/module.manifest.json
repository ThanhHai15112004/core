{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "settings",
  "displayName": "Dynamic System Settings & Scoped Configuration",
  "version": "1.0.0",
  "description": "Module quản trị cấu hình hệ thống động theo nhóm (email, file, security, ui, system), theo module/namespace, hỗ trợ kiểu TEXT/NUMBER/BOOLEAN/JSON, phân giải đa tầng (Global -> Environment -> Organization Unit), mã hóa secret, ghi lịch sử thay đổi và cache tốc độ cao",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "SettingsModule",
  "dependencies": ["database", "cache", "security", "i18n"],
  "permissions": ["settings.read", "settings.manage"],
  "events": {
    "published": [
      "settings.synced",
      "settings.group_created",
      "settings.setting_created",
      "settings.setting_updated",
      "settings.scope_overridden",
      "settings.scope_removed",
      "settings.feature_flags_synced",
      "settings.feature_flag_created",
      "settings.feature_flag_updated",
      "settings.feature_flag_toggled",
      "settings.i18n_synced",
      "settings.i18n_locale_created",
      "settings.i18n_locale_updated",
      "settings.i18n_timezone_created",
      "settings.i18n_timezone_updated",
      "settings.i18n_translation_upserted",
      "settings.sequences_synced",
      "settings.sequence_created",
      "settings.sequence_updated",
      "settings.sequence_generated"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "setting_groups",
      "system_settings",
      "system_setting_scopes",
      "system_setting_histories",
      "feature_flags",
      "feature_flag_histories",
      "i18n_locales",
      "i18n_timezones",
      "i18n_translations",
      "sequence_rules",
      "sequence_counters",
      "sequence_rule_histories"
    ]
  },
  "codeTypes": [
    {
      "code": "settings.value_type",
      "name": "Kiểu dữ liệu cấu hình hệ thống",
      "description": "Các kiểu dữ liệu được hỗ trợ và kiểm tra hợp lệ khi lưu cấu hình",
      "isSystem": true,
      "allowCustomValues": false,
      "values": [
        {
          "numericCode": 1,
          "code": "TEXT",
          "behaviorCode": "TEXT",
          "name": "Chuỗi văn bản (Text)",
          "labels": { "vi": "Chuỗi văn bản (Text)", "en": "Text String" },
          "badgeTone": "neutral",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "NUMBER",
          "behaviorCode": "NUMBER",
          "name": "Số (Number)",
          "labels": { "vi": "Số (Number)", "en": "Number" },
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "BOOLEAN",
          "behaviorCode": "BOOLEAN",
          "name": "Luận lý (Boolean)",
          "labels": { "vi": "Luận lý (Boolean)", "en": "Boolean" },
          "badgeTone": "success",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "JSON",
          "behaviorCode": "JSON",
          "name": "Đối tượng / Mảng JSON",
          "labels": { "vi": "Đối tượng / Mảng JSON", "en": "JSON Object / Array" },
          "badgeTone": "warning",
          "sortOrder": 4,
          "isSystem": true
        }
      ]
    }
  ],
  "settingGroups": [
    {
      "code": "email",
      "module": "settings",
      "name": "Cấu hình Email & Thông báo",
      "description": "Thiết lập máy chủ gửi thư SMTP, địa chỉ người gửi mặc định và giới hạn gửi email",
      "icon": "mail",
      "sortOrder": 1,
      "isSystem": true
    },
    {
      "code": "file",
      "module": "settings",
      "name": "Cấu hình Tệp tin & Lưu trữ",
      "description": "Thiết lập dung lượng tải lên tối đa, định dạng file cho phép và chính sách lưu trữ",
      "icon": "folder",
      "sortOrder": 2,
      "isSystem": true
    },
    {
      "code": "security",
      "module": "auth",
      "name": "Cấu hình Bảo mật & Xác thực",
      "description": "Thiết lập độ dài mật khẩu, độ phức tạp, khóa tài khoản, MFA và thời hạn phiên đăng nhập",
      "icon": "shield-lock",
      "sortOrder": 3,
      "isSystem": true
    },
    {
      "code": "ui",
      "module": "settings",
      "name": "Cấu hình Giao diện & Hiển thị",
      "description": "Thiết lập thương hiệu, giao diện sáng/tối, ngôn ngữ, múi giờ và số dòng phân trang mặc định",
      "icon": "palette",
      "sortOrder": 4,
      "isSystem": true
    },
    {
      "code": "system",
      "module": "settings",
      "name": "Cấu hình Vận hành Hệ thống",
      "description": "Thiết lập chế độ bảo trì, thời gian lưu trữ nhật ký và các tham số vận hành chung",
      "icon": "settings",
      "sortOrder": 5,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "email.smtp.host",
      "groupCode": "email",
      "module": "settings",
      "namespace": "system.email",
      "name": "Máy chủ SMTP Host",
      "description": "Địa chỉ máy chủ gửi thư đi (ví dụ: smtp.enterprise.vn)",
      "valueType": "TEXT",
      "defaultValue": "smtp.enterprise.vn",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1,
      "environmentOverrides": {
        "development": "localhost",
        "production": "smtp.enterprise.vn"
      }
    },
    {
      "key": "email.smtp.port",
      "groupCode": "email",
      "module": "settings",
      "namespace": "system.email",
      "name": "Cổng SMTP Port",
      "description": "Cổng kết nối máy chủ gửi thư (ví dụ: 587 hoặc 465)",
      "valueType": "NUMBER",
      "defaultValue": 587,
      "validationRules": { "min": 1, "max": 65535, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "email.smtp.password",
      "groupCode": "email",
      "module": "settings",
      "namespace": "system.email",
      "name": "Mật khẩu / API Key SMTP",
      "description": "Khóa bí mật xác thực máy chủ gửi email (tự động mã hóa và ẩn trên giao diện)",
      "valueType": "TEXT",
      "defaultValue": "",
      "isSensitive": true,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "file.upload.max_size_mb",
      "groupCode": "file",
      "module": "settings",
      "namespace": "system.file",
      "name": "Dung lượng tải lên tối đa (MB)",
      "description": "Giới hạn kích thước tối đa cho một tệp tải lên hệ thống",
      "valueType": "NUMBER",
      "defaultValue": 25,
      "validationRules": { "min": 1, "max": 2048, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "file.upload.allowed_extensions",
      "groupCode": "file",
      "module": "settings",
      "namespace": "system.file",
      "name": "Danh sách đuôi tệp cho phép",
      "description": "Mảng JSON các phần mở rộng tệp được phép tải lên",
      "valueType": "JSON",
      "defaultValue": ["pdf", "docx", "xlsx", "png", "jpg", "csv"],
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "ui.appearance.theme_config",
      "groupCode": "ui",
      "module": "settings",
      "namespace": "system.ui",
      "name": "Cấu hình chủ đề & thương hiệu",
      "description": "Cấu hình JSON cho chế độ sáng/tối, màu chủ đạo và số dòng phân trang mặc định",
      "valueType": "JSON",
      "defaultValue": {
        "mode": "light",
        "primaryColor": "#2563eb",
        "defaultPageSize": 20
      },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "ui.theme.default_mode",
      "groupCode": "ui",
      "module": "settings",
      "namespace": "system.ui",
      "name": "Chế độ giao diện mặc định",
      "description": "Chế độ hiển thị mặc định cho người dùng mới (light, dark, system)",
      "valueType": "TEXT",
      "defaultValue": "light",
      "validationRules": { "enumOptions": ["light", "dark", "system"] },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "ui.locale.default",
      "groupCode": "ui",
      "module": "settings",
      "namespace": "system.ui",
      "name": "Ngôn ngữ mặc định của hệ thống",
      "description": "Mã ngôn ngữ mặc định áp dụng khi người dùng chưa thiết lập tùy chọn cá nhân hoặc không gửi header ngôn ngữ (đồng bộ động với bảng i18n_locales)",
      "valueType": "TEXT",
      "defaultValue": "vi",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "ui.timezone.default",
      "groupCode": "ui",
      "module": "settings",
      "namespace": "system.ui",
      "name": "Múi giờ mặc định của hệ thống",
      "description": "Múi giờ IANA mặc định dùng cho lịch, báo cáo và hiển thị thời gian khi người dùng chưa chọn múi giờ (đồng bộ động với bảng i18n_timezones)",
      "valueType": "TEXT",
      "defaultValue": "Asia/Ho_Chi_Minh",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "ui.currency.default",
      "groupCode": "ui",
      "module": "settings",
      "namespace": "system.ui",
      "name": "Đơn vị tiền tệ mặc định",
      "description": "Mã tiền tệ ISO 4217 mặc định phục vụ định dạng tiền tệ trong báo cáo và giao dịch (đồng bộ động với bảng i18n_locales)",
      "valueType": "TEXT",
      "defaultValue": "VND",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "system.maintenance.enabled",
      "groupCode": "system",
      "module": "settings",
      "namespace": "system.general",
      "name": "Chế độ bảo trì hệ thống",
      "description": "Bật/tắt chế độ bảo trì toàn hệ thống (không cho phép ghi đè theo đơn vị)",
      "valueType": "BOOLEAN",
      "defaultValue": false,
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 1
    }
  ],
  "featureFlags": [
    {
      "key": "users.bulk_import_v2",
      "module": "users",
      "name": "Nhập/Xuất danh sách nhân sự hàng loạt thế hệ mới",
      "description": "Cho phép nhập và xuất hồ sơ người dùng hàng loạt qua định dạng CSV/XLSX có kiểm tra trùng lặp nâng cao",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "targetUserIds": [],
      "targetRoles": [],
      "targetOrganizationUnitIds": [],
      "isSystem": true
    },
    {
      "key": "auth.mfa_enforcement_pilot",
      "module": "auth",
      "name": "Thử nghiệm bắt buộc MFA theo nhóm vai trò và chi nhánh",
      "description": "Tính năng thử nghiệm yêu cầu xác thực đa yếu tố (TOTP/Email OTP) theo nhóm người dùng, vai trò hoặc đơn vị chỉ định",
      "isEnabled": false,
      "rolloutPercentage": 100,
      "targetUserIds": [],
      "targetRoles": ["SUPER_ADMIN", "SECURITY_ADMIN"],
      "targetOrganizationUnitIds": [],
      "isSystem": true
    },
    {
      "key": "settings.realtime_broadcast",
      "module": "settings",
      "name": "Đồng bộ tức thời cấu hình qua sự kiện phân tán",
      "description": "Phát sóng thay đổi cấu hình và Feature Flag theo tỷ lệ rollout để làm mới cache các node ứng dụng",
      "isEnabled": true,
      "rolloutPercentage": 50,
      "targetUserIds": [],
      "targetRoles": [],
      "targetOrganizationUnitIds": [],
      "isSystem": true
    }
  ],
  "sequences": [
    {
      "key": "settings.order_code",
      "module": "settings",
      "name": "Mã đơn hàng nghiệp vụ (Order Sequence)",
      "description": "Mẫu sinh mã đơn hàng chuẩn theo năm (ví dụ: ORD-2026-000001), tự động reset số thứ tự khi sang năm mới",
      "prefix": "ORD",
      "suffix": "",
      "separator": "-",
      "dateFormat": "YYYY",
      "paddingLength": 6,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "YEARLY",
      "scopeByUnit": false,
      "timezone": "Asia/Ho_Chi_Minh",
      "isSystem": true
    },
    {
      "key": "settings.invoice_code",
      "module": "settings",
      "name": "Mã hóa đơn tài chính (Invoice Sequence)",
      "description": "Mẫu sinh mã hóa đơn theo năm và tháng (ví dụ: INV-202610-000001), tự động reset số thứ tự hàng tháng",
      "prefix": "INV",
      "suffix": "",
      "separator": "-",
      "dateFormat": "YYYYMM",
      "paddingLength": 6,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "MONTHLY",
      "scopeByUnit": false,
      "timezone": "Asia/Ho_Chi_Minh",
      "isSystem": true
    }
  ],
  "locales": [
    {
      "code": "vi",
      "bcp47Tag": "vi-VN",
      "name": "Vietnamese",
      "nativeName": "Tiếng Việt",
      "direction": "ltr",
      "dateFormat": "dd/MM/yyyy",
