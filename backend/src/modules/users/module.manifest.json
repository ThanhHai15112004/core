{
  "$schema": "../../packages/kernel/schemas/module.manifest.schema.json",
  "name": "users",
  "displayName": "User Management",
  "version": "1.0.0",
  "description": "Module quản lý vòng đời tài khoản người dùng, phân bổ vai trò, đơn vị/chi nhánh, nhập/xuất hàng loạt và trạng thái Active/Inactive/Locked",
  "type": "core",
  "category": "core",
  "author": "Core Platform Team",
  "entryModule": "UsersModule",
  "dependencies": ["database", "redis", "organizations", "roles"],
  "permissions": [
    "users.read",
    "users.create",
    "users.update",
    "users.lock",
    "users.status",
    "users.assign_roles",
    "users.assign_organizations",
    "users.import",
    "users.export"
  ],
  "events": {
    "published": [
      "user.created",
      "user.updated",
      "user.locked",
      "user.unlocked",
      "user.deactivated",
      "user.activated",
      "user.archived",
      "user.restored",
      "user.roles_assigned",
      "user.organizations_assigned"
    ],
    "subscribed": []
  },
  "database": {
    "hasMigrations": true,
    "tables": [
      "users",
      "user_profiles",
      "user_roles",
      "user_organization_units",
      "user_status_histories"
    ]
  },
  "codeTypes": [
    {
      "code": "users.status",
      "name": "Trạng thái tài khoản người dùng",
      "description": "Trạng thái vòng đời tài khoản (Hybrid: gắn với State Machine đăng nhập & khóa tài khoản)",
      "isSystem": true,
      "allowCustomValues": true,
      "values": [
        {
          "numericCode": 1,
          "code": "ACTIVE",
          "behaviorCode": "ACTIVE",
          "name": "Đang làm việc",
          "labels": { "vi": "Đang làm việc", "en": "Active" },
          "aliases": ["HOẠT ĐỘNG", "HOAT DONG", "ĐANG LÀM VIỆC", "DANG LAM VIEC", "ON"],
          "badgeTone": "success",
          "color": "emerald",
          "sortOrder": 1,
          "isDefault": true,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "INACTIVE",
          "behaviorCode": "INACTIVE",
          "name": "Ngừng hoạt động / Nghỉ việc",
          "labels": { "vi": "Ngừng hoạt động / Nghỉ việc", "en": "Inactive" },
          "aliases": [
            "0",
            "NGHỈ VIỆC",
            "NGHI VIEC",
            "NGỪNG",
            "NGỪNG HOẠT ĐỘNG",
            "VÔ HIỆU",
            "VÔ HIỆU HÓA",
            "TẮT",
            "TAT",
            "OFF"
          ],
          "badgeTone": "warning",
          "color": "slate",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "LOCKED",
          "behaviorCode": "LOCKED",
          "name": "Đang bị khóa",
          "labels": { "vi": "Đang bị khóa", "en": "Locked" },
          "aliases": ["KHÓA", "KHOA", "BỊ KHÓA", "ĐANG BỊ KHÓA", "TẠM KHÓA", "TAM KHOA", "TẠM HOÃN", "TAM HOAN"],
          "badgeTone": "danger",
          "color": "rose",
          "sortOrder": 3,
          "isSystem": true
        },
        {
          "numericCode": 4,
          "code": "ARCHIVED",
          "behaviorCode": "ARCHIVED",
          "name": "Đã lưu trữ",
          "labels": { "vi": "Đã lưu trữ", "en": "Archived" },
          "aliases": ["LƯU TRỮ", "LUU TRU", "ĐÃ LƯU TRỮ"],
          "badgeTone": "neutral",
          "color": "zinc",
          "sortOrder": 4,
          "isSystem": true
        }
      ]
    },
    {
      "code": "users.gender",
      "name": "Giới tính",
      "description": "Danh mục giới tính hồ sơ người dùng (100% Dynamic Lookup)",
      "isSystem": true,
      "allowCustomValues": true,
      "values": [
        {
          "numericCode": 1,
          "code": "MALE",
          "name": "Nam",
          "labels": { "vi": "Nam", "en": "Male" },
          "aliases": ["NAM", "M", "BOY"],
          "badgeTone": "info",
          "sortOrder": 1,
          "isSystem": true
        },
        {
          "numericCode": 2,
          "code": "FEMALE",
          "name": "Nữ",
          "labels": { "vi": "Nữ", "en": "Female" },
          "aliases": ["NỮ", "NU", "F", "GIRL"],
          "badgeTone": "info",
          "sortOrder": 2,
          "isSystem": true
        },
        {
          "numericCode": 3,
          "code": "OTHER",
          "name": "Khác",
          "labels": { "vi": "Khác", "en": "Other" },
          "aliases": ["KHÁC", "KHAC", "UNKNOWN", "O"],
          "badgeTone": "neutral",
          "sortOrder": 3,
          "isSystem": true
        }
      ]
    },
    {
      "code": "users.position_title",
      "name": "Chức danh công việc",
      "description": "Danh mục chức danh công việc của nhân sự trong đơn vị (100% Dynamic Lookup)",
      "isSystem": true,
      "allowCustomValues": true,
      "values": [
        {
          "numericCode": 1,
          "code": "DIRECTOR",
          "name": "Giám đốc",
          "labels": { "vi": "Giám đốc", "en": "Director" },
          "badgeTone": "info",
          "sortOrder": 1,
          "isSystem": false
        },
        {
          "numericCode": 2,
          "code": "DEPARTMENT_HEAD",
          "name": "Trưởng phòng",
          "labels": { "vi": "Trưởng phòng", "en": "Department Head" },
          "badgeTone": "success",
          "sortOrder": 2,
          "isSystem": false
        },
        {
          "numericCode": 3,
          "code": "TEAM_LEAD",
          "name": "Trưởng nhóm",
          "labels": { "vi": "Trưởng nhóm", "en": "Team Lead" },
          "badgeTone": "success",
          "sortOrder": 3,
          "isSystem": false
        },
        {
          "numericCode": 4,
          "code": "SPECIALIST",
          "name": "Chuyên viên",
          "labels": { "vi": "Chuyên viên", "en": "Specialist" },
          "badgeTone": "neutral",
          "sortOrder": 4,
          "isDefault": true,
          "isSystem": false
        }
      ]
    }
  ],
  "settingGroups": [
    {
      "code": "users",
      "module": "users",
      "name": "Cấu hình Quản lý Người dùng & Nhân sự",
      "description": "Thiết lập tham số nhập/xuất hồ sơ nhân sự, phân trang, vai trò mặc định và lịch sử đăng nhập",
      "icon": "users",
      "sortOrder": 6,
      "isSystem": true
    }
  ],
  "settings": [
    {
      "key": "users.import.default_password",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.import",
      "name": "Mật khẩu mặc định khi nhập hàng loạt (Bulk Import)",
      "description": "Mật khẩu khởi tạo mặc định cho tài khoản nhân sự được import khi dòng dữ liệu và request không chỉ định mật khẩu riêng (tự động mã hóa AES-256-GCM)",
      "valueType": "TEXT",
      "defaultValue": "Abcd@454647#",
      "isSensitive": true,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 1
    },
    {
      "key": "users.export.max_rows",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.export",
      "name": "Số dòng tối đa cho mỗi lần xuất danh sách nhân sự",
      "description": "Giới hạn số lượng bản ghi người dùng tối đa được xuất ra file Excel (.xlsx) hoặc CSV (.csv) trong một lần truy vấn",
      "valueType": "NUMBER",
      "defaultValue": 5000,
      "validationRules": { "min": 100, "max": 100000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 2
    },
    {
      "key": "users.export.default_report_title",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.export",
      "name": "Tiêu đề báo cáo xuất danh sách nhân sự mặc định",
      "description": "Tiêu đề hiển thị trên đầu trang tính Excel khi xuất danh sách người dùng (cho phép ghi đè theo từng đơn vị/chi nhánh)",
      "valueType": "TEXT",
      "defaultValue": "DANH SÁCH CÁN BỘ NHÂN VIÊN",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 3
    },
    {
      "key": "users.pagination.default_page_size",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.pagination",
      "name": "Số dòng mặc định mỗi trang danh sách người dùng",
      "description": "Số lượng bản ghi người dùng trả về mặc định khi truy vấn danh sách mà không truyền tham số limit",
      "valueType": "NUMBER",
      "defaultValue": 20,
      "validationRules": { "min": 1, "max": 500, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 4
    },
    {
      "key": "users.pagination.max_page_size",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.pagination",
      "name": "Số dòng tối đa mỗi trang danh sách người dùng",
      "description": "Giới hạn số lượng bản ghi tối đa trên một trang khi tra cứu danh sách người dùng",
      "valueType": "NUMBER",
      "defaultValue": 500,
      "validationRules": { "min": 10, "max": 5000, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 5
    },
    {
      "key": "users.default_role_code",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.general",
      "name": "Mã vai trò mặc định của người dùng",
      "description": "Mã vai trò dự phòng cấp cho tài khoản người dùng khi chưa được gán vai trò tường minh trong bảng user_roles",
      "valueType": "TEXT",
      "defaultValue": "user",
      "isSensitive": false,
      "allowUnitOverride": true,
      "isSystem": true,
      "sortOrder": 6
    },
    {
      "key": "users.login_history.default_limit",
      "groupCode": "users",
      "module": "users",
      "namespace": "users.login_history",
      "name": "Số dòng lịch sử đăng nhập hiển thị mặc định",
      "description": "Số lượng bản ghi lịch sử đăng nhập và đăng xuất gần nhất trả về mặc định khi xem chi tiết hồ sơ người dùng",
      "valueType": "NUMBER",
      "defaultValue": 50,
      "validationRules": { "min": 1, "max": 500, "integerOnly": true },
      "isSensitive": false,
      "allowUnitOverride": false,
      "isSystem": true,
      "sortOrder": 7
    }
  ],
  "featureFlags": [
    {
      "key": "users.bulk_import_v2",
      "module": "users",
      "name": "Nhập/Xuất danh sách nhân sự hàng loạt thế hệ mới",
      "description": "Cho phép nhập và xuất hồ sơ người dùng hàng loạt qua định dạng CSV/XLSX có kiểm tra trùng lặp nâng cao",
      "isEnabled": true,
      "rolloutPercentage": 100,
      "targetUserIds": [],
      "targetRoles": [],
      "targetOrganizationUnitIds": [],
      "isSystem": true
    }
  ],
  "sequences": [
    {
      "key": "users.employee_code",
      "module": "users",
      "name": "Mã hồ sơ nhân sự (Employee Code)",
      "description": "Mẫu sinh mã nhân sự tự động theo năm tuyển dụng (ví dụ: EMP-2026-000001)",
      "prefix": "EMP",
      "suffix": "",
      "separator": "-",
      "dateFormat": "YYYY",
      "paddingLength": 6,
      "startValue": 1,
      "step": 1,
      "resetPolicy": "YEARLY",
      "scopeByUnit": false,
      "timezone": "Asia/Ho_Chi_Minh",
      "isSystem": true
    }
  ],
  "menus": [
    {
      "code": "IAM",
      "name": "Quản trị Định danh & Truy cập",
      "status": 1,
      "link": null,
      "linkApi": "/api/v1/users",
      "type": 1,
      "parent": null,
      "level": 1,
      "key": null,
      "numOrder": 10,
      "icon": "ShieldCheck",
      "position": "SIDEBAR"
    },
    {
      "code": "IAM_USERS",
      "name": "Người dùng",
      "status": 1,
      "link": "/iam/users",
      "linkApi": "/api/v1/users",
      "type": 2,
      "parentCode": "IAM",
      "level": 2,
      "key": "users.read",
      "numOrder": 1,
      "icon": "Users",
      "position": "SIDEBAR"
    }
  ]
}
