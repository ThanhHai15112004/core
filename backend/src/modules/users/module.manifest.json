      "isHeavy": false,
      "heavyRecordThreshold": 2000,
      "cacheTtlSeconds": 300,
      "supportsReadReplica": true,
      "supportedFormats": ["xlsx", "csv", "pdf"],
      "parameters": [
        { "key": "dateRange", "name": "Khoảng ngày tạo", "type": "date-range", "required": false },
        { "key": "status", "name": "Trạng thái tài khoản", "type": "status", "required": false },
        { "key": "organizationUnitId", "name": "Đơn vị / Phòng ban", "type": "organization-unit", "required": false },
        { "key": "filters", "name": "Bộ lọc mở rộng", "type": "filter", "required": false }
      ],
      "isSystem": true,
      "status": 1
    },
    {
      "code": "users.security_compliance",
      "module": "users",
      "name": "Báo cáo tuân thủ bảo mật & phiên đăng nhập nhân sự",
      "description": "Báo cáo chuyên sâu các tài khoản chưa bật MFA, tài khoản bị khóa hoặc lâu chưa đăng nhập theo từng đơn vị",
      "category": "REPORT",
      "requiredPermission": "users.report",
      "isHeavy": true,
      "heavyRecordThreshold": 500,
      "cacheTtlSeconds": 600,
      "supportsReadReplica": true,
      "supportedFormats": ["xlsx", "csv", "pdf"],
      "parameters": [
        { "key": "dateRange", "name": "Khoảng ngày", "type": "date-range", "required": false },
        { "key": "status", "name": "Trạng thái tài khoản", "type": "status", "required": false },
        { "key": "organizationUnitId", "name": "Đơn vị / Phòng ban", "type": "organization-unit", "required": false },
        { "key": "filters", "name": "Bộ lọc mở rộng", "type": "filter", "required": false }
      ],
      "isSystem": true,
      "status": 1
    }
  ],
  "searchableEntities": [
    {
      "code": "users.account",
      "module": "users",
      "entityType": "user",
      "name": "Tài khoản & Hồ sơ nhân sự",
      "description": "Tìm kiếm cán bộ nhân viên theo họ tên, mã nhân viên, tên đăng nhập, email và số điện thoại",
      "requiredPermission": "users.read",
      "searchableFields": ["fullName", "employeeCode", "username", "email", "phone"],
      "titleField": "fullName",
      "subtitleField": "email",
      "staleThresholdMs": 300000,
      "isSystem": true,
      "status": 1
    }
  ],
  "extensibleEntities": [
    {
      "code": "users.user",
      "module": "users",
      "entityType": "user",
      "name": "Hồ sơ Cán bộ Nhân viên (User)",
      "description": "Cho phép mở rộng các trường thông tin tùy chỉnh và metadata trên hồ sơ người dùng",
      "primaryKeyField": "id",
      "readPermission": "users.read",
      "writePermission": "users.update",
      "maxCustomFields": 50,
      "allowDynamicFields": true,
      "isSystem": true,
      "status": 1
    }
  ],
  "customFields": [
