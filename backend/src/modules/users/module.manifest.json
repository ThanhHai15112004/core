  "reports": [
    {
      "code": "users.summary_dashboard",
      "module": "users",
      "name": "Báo cáo tổng hợp nhân sự & trạng thái tài khoản",
      "description": "Thống kê tổng số nhân sự theo trạng thái, đơn vị, tỷ lệ kích hoạt MFA và xu hướng tạo tài khoản",
      "category": "DASHBOARD",
