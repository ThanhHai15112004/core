        { "optionCode": "L3", "label": "L3 - Chuyên viên cao cấp (Senior)", "sortOrder": 3, "isDefault": false, "status": 1 },
        { "optionCode": "L4", "label": "L4 - Trưởng nhóm / Chuyên gia (Lead)", "sortOrder": 4, "isDefault": false, "status": 1 },
        { "optionCode": "L5", "label": "L5 - Giám đốc / Điều hành (Director)", "sortOrder": 5, "isDefault": false, "status": 1 },
        { "optionCode": "L0_LEGACY", "label": "L0 - Cộng tác viên cũ (Ngừng dùng)", "sortOrder": 6, "isDefault": false, "status": 2 }
