# ==============================================================================
# Stage 1: Build TypeScript NestJS sang JavaScript
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy các file cấu hình build
COPY backend/package*.json backend/project.manifest.json ./
COPY backend/tsconfig*.json ./

# Cài đặt đầy đủ dependencies phục vụ biên dịch bằng lockfile cố định
RUN npm ci

# Copy toàn bộ mã nguồn backend và tiến hành build
COPY backend/src ./src
RUN npm run build

# ==============================================================================
# Stage 2: Production Runner siêu nhẹ (Non-root user)
# ==============================================================================
FROM node:22-alpine AS runner

ARG APP_VERSION="1.0.0"
ARG APP_GIT_COMMIT=""
ARG APP_IMAGE=""
ARG APP_BUILD_TIME=""
ARG APP_SOURCE_URL=""

LABEL org.opencontainers.image.title="core-backend" \
      org.opencontainers.image.description="Core Framework Backend Multi-Runtime (API, Worker, Scheduler, CLI)" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${APP_GIT_COMMIT}" \
      org.opencontainers.image.created="${APP_BUILD_TIME}" \
      org.opencontainers.image.source="${APP_SOURCE_URL}"

WORKDIR /app

ENV NODE_ENV=production \
    APP_VERSION=${APP_VERSION} \
    APP_GIT_COMMIT=${APP_GIT_COMMIT} \
    APP_IMAGE=${APP_IMAGE} \
    APP_BUILD_TIME=${APP_BUILD_TIME}

# Chỉ cài production dependencies bằng lockfile cố định
COPY backend/package*.json backend/project.manifest.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy mã nguồn đã build từ Stage 1
COPY --from=builder /app/dist ./dist

# Chạy dưới quyền user node an toàn (chống leo thang đặc quyền container)
USER node

EXPOSE 3005

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3005/api/v1/health >/dev/null || exit 1

CMD ["node", "dist/apps/api/main.js"]
