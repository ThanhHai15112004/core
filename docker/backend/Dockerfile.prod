# ==============================================================================
# Stage 1: Build TypeScript NestJS sang JavaScript
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy các file cấu hình build
COPY backend/package*.json ./
COPY backend/tsconfig*.json ./

# Cài đặt đầy đủ dependencies phục vụ biên dịch
RUN npm install

# Copy toàn bộ mã nguồn backend và tiến hành build
COPY backend/src ./src
RUN npm run build

# ==============================================================================
# Stage 2: Production Runner siêu nhẹ (Non-root user)
# ==============================================================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Chỉ cài production dependencies
COPY backend/package*.json ./
RUN npm install --omit=dev && npm cache clean --force

# Copy mã nguồn đã build từ Stage 1
COPY --from=builder /app/dist ./dist

# Chạy dưới quyền user node an toàn (chống leo thang đặc quyền container)
USER node

EXPOSE 3005

CMD ["node", "dist/apps/api/main.js"]
