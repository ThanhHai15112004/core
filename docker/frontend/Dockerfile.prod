# ==============================================================================
# Stage 1: Build React 19 Frontend bằng Vite
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy các file cấu hình frontend
COPY frontend/package*.json ./
COPY frontend/tsconfig*.json ./
COPY frontend/vite.config.ts ./
COPY frontend/index.html ./

# Cài đặt dependencies phục vụ build bằng lockfile cố định
RUN npm ci

# Copy mã nguồn frontend
COPY frontend/src ./src
COPY frontend/public ./public

# Nhận biến API URL lúc build (mặc định trỏ về /api/v1 tương đối qua Nginx)
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Biên dịch ra thư mục tĩnh dist/
RUN npm run build

# ==============================================================================
# Stage 2: Đồng bộ file tĩnh + sinh runtime env-config.js (Build-once cho mọi môi trường)
# ==============================================================================
FROM alpine:3.21

ARG APP_VERSION="1.0.0"
ARG APP_GIT_COMMIT=""
ARG APP_BUILD_TIME=""
ARG APP_SOURCE_URL=""

LABEL org.opencontainers.image.title="core-frontend" \
      org.opencontainers.image.description="Core Framework Frontend Static Bundle (Build-Once Runtime Configurable)" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${APP_GIT_COMMIT}" \
      org.opencontainers.image.created="${APP_BUILD_TIME}" \
      org.opencontainers.image.source="${APP_SOURCE_URL}"

ENV APP_VERSION=${APP_VERSION} \
    APP_GIT_COMMIT=${APP_GIT_COMMIT} \
    APP_BUILD_TIME=${APP_BUILD_TIME}

WORKDIR /app

COPY --from=builder /app/dist /app/dist
COPY docker/frontend/entrypoint.prod.sh /app/entrypoint.prod.sh
RUN chmod +x /app/entrypoint.prod.sh

# Khi container khởi động: sync dist, tạo env-config.js theo env môi trường hiện tại rồi giữ trạng thái
ENTRYPOINT ["/app/entrypoint.prod.sh"]
