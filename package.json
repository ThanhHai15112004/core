{
  "name": "core",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Node.js foundation for small web applications using NestJS",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node -e \"process.argv=['node', 'nest', 'build']; const p = require('path').resolve(process.env.INIT_CWD || '.', 'node_modules/@nestjs/cli/bin/nest.js'); process.chdir(process.env.INIT_CWD || '.'); require(p);\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node -e \"const { pathToFileURL } = require('node:url'); const p = require('node:path').resolve(process.env.INIT_CWD || '.', 'dist/main.js'); import(pathToFileURL(p).href);\"",
    "start:dev": "node -e \"process.argv=['node', 'nest', 'start', '--watch']; const p = require('path').resolve(process.env.INIT_CWD || '.', 'node_modules/@nestjs/cli/bin/nest.js'); process.chdir(process.env.INIT_CWD || '.'); require(p);\"",
    "start:debug": "node -e \"process.argv=['node', 'nest', 'start', '--debug', '--watch']; const p = require('path').resolve(process.env.INIT_CWD || '.', 'node_modules/@nestjs/cli/bin/nest.js'); process.chdir(process.env.INIT_CWD || '.'); require(p);\"",
    "start:prod": "node -e \"const { pathToFileURL } = require('node:url'); const p = require('node:path').resolve(process.env.INIT_CWD || '.', 'dist/main.js'); import(pathToFileURL(p).href);\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "node -e \"const p = require('path').resolve(process.env.INIT_CWD || '.', 'node_modules/typescript/bin/tsc'); process.chdir(process.env.INIT_CWD || '.'); require(p);\" -- --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  }
}
