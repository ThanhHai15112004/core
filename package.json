{
  "name": "core-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:fe": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev:api",
    "dev:worker": "npm --prefix backend run dev:worker",
    "dev:scheduler": "npm --prefix backend run dev:scheduler",
    "cli": "npm --prefix backend run cli",
    "build": "npm --prefix backend run build",
    "build:fe": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend run test",
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "test:integration:live": "npm --prefix backend run test:integration:live",
    "test:feature": "npm --prefix backend run test:feature",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:cov": "npm --prefix backend run test:cov",
    "test:cov:module": "npm --prefix backend run test:cov:module",
    "check": "npm --prefix backend run check",
    "check:fe": "npm --prefix frontend run lint && npm --prefix frontend run typecheck && npm --prefix frontend run test && npm --prefix frontend run build",
    "ci:lockfiles": "node scripts/ci/check-lockfiles.mjs",
    "ci:api-diff": "node scripts/ci/check-api-changes.mjs",
    "ci:report": "node scripts/ci/ci-report.mjs --run",
    "ci:guard": "node scripts/ci/guard-diff.mjs",
    "ci:validate": "node scripts/ci/check-lockfiles.mjs && bash scripts/ci/validate-configs.sh && node scripts/ci/guard-diff.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:secrets:staged": "node scripts/security/scan-secrets.mjs --staged",
    "security:deps": "node scripts/security/scan-dependencies.mjs",
    "security:sast": "node scripts/security/scan-sast.mjs",
    "security:iac": "node scripts/security/scan-iac.mjs",
    "security:licenses": "node scripts/security/check-licenses.mjs",
    "security:sbom": "node scripts/security/generate-sbom.mjs",
    "security:images": "bash scripts/security/scan-docker-images.sh",
    "security:dast": "node scripts/security/run-dast.mjs",
    "security:all": "node scripts/security/run-all.mjs",
    "test:security": "node --test scripts/security/security-scanners.test.mjs",
    "deploy:build": "bash scripts/deploy/build-release.sh",
    "deploy:manifest": "node scripts/deploy/release-manifest.mjs",
    "deploy:smoke": "node scripts/deploy/smoke-test.mjs",
    "deploy:run": "bash scripts/deploy/deploy.sh",
    "deploy:rollback": "bash scripts/deploy/rollback.sh",
    "deploy:prune": "node scripts/deploy/prune-registry.mjs",
    "test:deploy": "node --test scripts/deploy/deploy-scripts.test.mjs",
    "docker:up": "./docker-dev.sh up",
    "docker:down": "./docker-dev.sh down",
    "docker:restart": "./docker-dev.sh restart",
    "docker:logs": "./docker-dev.sh logs",
    "docker:ps": "./docker-dev.sh ps",
    "docker:smoke": "./docker-dev.sh smoke",
    "docker:prod:up": "./docker-prod.sh up",
    "docker:prod:down": "./docker-prod.sh down",
    "docker:prod:smoke": "./docker-prod.sh smoke",
    "load-test:autoscaling": "node scripts/load-test/autoscaling-load-test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
